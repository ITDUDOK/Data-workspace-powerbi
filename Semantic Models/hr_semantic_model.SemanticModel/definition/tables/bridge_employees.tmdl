table bridge_employees
	lineageTag: 275966d6-abbb-40d5-9662-6ed4a86a4256
	sourceLineageTag: [dbo].[hr_dl_bridge_employees]

	measure ContractUren =
			IF(
			    HASONEVALUE('bridge_employees'[FullName]),
			    MIN('bridge_employees'[CardContractHours]),
			    BLANK()
			)
		formatString: 0
		lineageTag: 32550fe7-4906-4530-b43d-b1bd98b89b52

	measure Uurloon_Exclusief =
			IF(
			    HASONEVALUE('bridge_employees'[FullName]),
			    MIN('bridge_employees'[CardHourlySalary]),
			    BLANK()
			)
		lineageTag: 52ba4443-b880-4e2c-ac3e-2a0f6053c1d2

	measure ContractHoursHR_Alt =
			VAR SelectedEmployee = SELECTEDVALUE('bridge_employees'[CardID])
			RETURN
			IF(
			    ISBLANK(SelectedEmployee),
			    BLANK(),
			    MAXX(
			        FILTER(
			            'bridge_employees',
			            'bridge_employees'[CardID] = SelectedEmployee
			        ),
			        'bridge_employees'[CardContractHours]
			    )
			)
		lineageTag: eac42f07-4d80-458a-b052-590a7bbf668d

	measure 'FTE EMPLOYEES' =
			VAR StandardHours = 38
			VAR SelectedStartDate = MIN('dim_date'[Date])
			VAR SelectedEndDate = MAX('dim_date'[Date])
			
			RETURN
			IF(
			    ISBLANK(SelectedStartDate),
			    0,
			    SUMX(
			        SUMMARIZE(
			            FILTER(
			                'bridge_employees',
			                NOT(ISBLANK('bridge_employees'[EmployeeStartDate])) &&
			                'bridge_employees'[EmployeeStartDate] <= SelectedEndDate &&
			                'bridge_employees'[EmployeeEndDate] >= SelectedStartDate
			            ),
			            'bridge_employees'[FullName],
			            "MaxHours", MAX('bridge_employees'[CardContractHours])
			        ),
			        DIVIDE([MaxHours], StandardHours, 0)
			    )
			)
		lineageTag: 53ef9416-24a0-46d7-b36f-f33628854af9

	measure 'Gem. Uurloon incl' =
			VAR SelectedStartDate = MIN('dim_date'[Date])
			VAR SelectedEndDate = MAX('dim_date'[Date])
			
			RETURN
			IF(
			    ISBLANK(SelectedStartDate),
			    BLANK(),
			    AVERAGEX(
			        SUMMARIZE(
			            FILTER(
			                'bridge_employees',
			                NOT(ISBLANK('bridge_employees'[EmployeeStartDate])) &&
			                'bridge_employees'[EmployeeStartDate] <= SelectedEndDate &&
			                'bridge_employees'[EmployeeEndDate] >= SelectedStartDate &&
			                NOT(ISBLANK('bridge_employees'[CardSalaryRate]))
			            ),
			            'bridge_employees'[FullName],
			            "MaxSalaryRate", MAX('bridge_employees'[CardSalaryRate])
			        ),
			        [MaxSalaryRate]
			    )
			)
		lineageTag: 44a856f2-bcc1-48b0-9b3d-c63f427683df

	measure 'Gem. Leeftijd' =
			VAR SelectedStartDate = MIN('dim_date'[Date])
			VAR SelectedEndDate = MAX('dim_date'[Date])
			VAR ReferenceDate = TODAY()
			
			RETURN
			IF(
			    ISBLANK(SelectedStartDate),
			    BLANK(),
			    VAR ActiveEmployees =
			        SUMMARIZE(
			            FILTER(
			                'bridge_employees',
			                NOT(ISBLANK('bridge_employees'[EmployeeStartDate])) &&
			                'bridge_employees'[EmployeeStartDate] <= SelectedEndDate &&
			                'bridge_employees'[EmployeeEndDate] >= SelectedStartDate &&
			                NOT(ISBLANK('bridge_employees'[CardDateofBirth]))
			            ),
			            'bridge_employees'[FullName],
			            "DateOfBirth", MAX('bridge_employees'[CardDateofBirth])
			        )
			
			    VAR TotalAge =
			        SUMX(
			            ActiveEmployees,
			            VAR BirthDate = [DateOfBirth]
			            VAR YearDiff = YEAR(ReferenceDate) - YEAR(BirthDate)
			            VAR HadBirthdayThisYear =
			                (MONTH(ReferenceDate) > MONTH(BirthDate)) ||
			                (MONTH(ReferenceDate) = MONTH(BirthDate) && DAY(ReferenceDate) >= DAY(BirthDate))
			            VAR Age = YearDiff - IF(HadBirthdayThisYear, 0, 1)
			            RETURN Age
			        )
			
			    VAR TotalPersons = COUNTROWS(ActiveEmployees)
			
			    VAR AverageAge =
			        IF(
			            TotalPersons > 0,
			            DIVIDE(TotalAge, TotalPersons, BLANK()),
			            BLANK()
			        )
			
			    RETURN
			        IF(
			            NOT(ISBLANK(AverageAge)),
			            INT(AverageAge),
			            BLANK()
			        )
			)
		formatString: #,0
		lineageTag: 8ddc1a2b-1b69-40c9-bbe3-561639adab81

	measure 'Gem. Uurloon excl' =
			VAR SelectedStartDate = MIN('dim_date'[Date])
			VAR SelectedEndDate = MAX('dim_date'[Date])
			
			RETURN
			IF(
			    ISBLANK(SelectedStartDate),
			    BLANK(),
			    VAR ActiveEmployees =
			        SUMMARIZE(
			            FILTER(
			                'bridge_employees',
			                NOT(ISBLANK('bridge_employees'[EmployeeStartDate])) &&
			                'bridge_employees'[EmployeeStartDate] <= SelectedEndDate &&
			                'bridge_employees'[EmployeeEndDate] >= SelectedStartDate &&
			                NOT(ISBLANK('bridge_employees'[CardHourlySalary]))
			            ),
			            'bridge_employees'[FullName],
			            "MaxHourlySalary", MAX('bridge_employees'[CardHourlySalary])
			        )
			
			    VAR TotalSalary = SUMX(ActiveEmployees, [MaxHourlySalary])
			    VAR TotalPersons = COUNTROWS(ActiveEmployees)
			
			    RETURN
			    IF(
			        TotalPersons > 0,
			        DIVIDE(TotalSalary, TotalPersons, BLANK()),
			        BLANK()
			    )
			)
		lineageTag: 554559be-1512-4c7c-a6a0-6c88dca889bc

	measure 'Ziekteverzuim %' =
			VAR SelectedStartDate = MIN('dim_date'[Date])
			VAR SelectedEndDate = MAX('dim_date'[Date])
			RETURN
			IF(
			    ISBLANK(SelectedStartDate),
			    BLANK(),
			    VAR PeriodeDagen = DATEDIFF(SelectedStartDate, SelectedEndDate, DAY) + 1
			    VAR AantalWeken = PeriodeDagen / 7
			    VAR CurrentCardIDs = VALUES('bridge_employees'[CardID])
			
			    VAR TotaalZiekteuren =
			        CALCULATE(
			            SUM('fact_sickness'[SicknessHours]),
			            'fact_sickness'[CardID] IN CurrentCardIDs,
			            'fact_sickness'[SicknessStart] <= SelectedEndDate,
			            'fact_sickness'[SicknessEnd] >= SelectedStartDate
			        )
			
			    VAR WerkelijkGewerktUren =
			        CALCULATE(
			            SUM('fact_hours'[HourHours]),
			            'fact_hours'[CardID] IN CurrentCardIDs,
			            'fact_hours'[HourDate] >= SelectedStartDate,
			            'fact_hours'[HourDate] <= SelectedEndDate
			        )
			
			    VAR ContractUren_ =
			        SUMX('bridge_employees', 'bridge_employees'[CardContractHours] * AantalWeken)
			
			    VAR TotaalUren =
			        IF(
			            COUNTROWS(FILTER('bridge_employees', 'bridge_employees'[OfficeID] = 11)) > 0 && WerkelijkGewerktUren > 0,
			            WerkelijkGewerktUren,
			            ContractUren_
			        )
			
			    RETURN IF(TotaalUren > 0, TotaalZiekteuren / TotaalUren, BLANK())
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c3e44f49-d57a-4db8-bc23-91ceee55b551

	measure 'Aantal Ziektemeldingen' =
			VAR SelectedStartDate = MIN('dim_date'[Date])
			VAR SelectedEndDate = MAX('dim_date'[Date])
			
			RETURN
			IF(
			    ISBLANK(SelectedStartDate),
			    BLANK(),
			    VAR CurrentCardIDs = VALUES('bridge_employees'[CardID])
			
			    VAR AantalMeldingen =
			        CALCULATE(
			            DISTINCTCOUNT('fact_sickness'[MeldingID]),
			            'fact_sickness'[CardID] IN CurrentCardIDs,
			            'fact_sickness'[SicknessStart] <= SelectedEndDate,
			            'fact_sickness'[SicknessEnd] >= SelectedStartDate
			        )
			
			    RETURN AantalMeldingen
			)
		formatString: 0
		lineageTag: 597be1a5-fee0-4bc4-98a2-9387fb40b7a8

	measure 'Historical Employee Active' =
			VAR SelectedStartDate = MIN('dim_date'[Date])
			VAR SelectedEndDate = MAX('dim_date'[Date])
			VAR CurrentEmployeeIds = VALUES('bridge_employees'[employeeId])
			RETURN
			IF(
			    ISBLANK(SelectedStartDate),
			    0,
			    VAR HasContract =
			        SUMX(
			            CurrentEmployeeIds,
			            VAR EmpId = 'bridge_employees'[employeeId]
			            RETURN
			            CALCULATE(
			                COUNTROWS('fact_hrcontracts'),
			                ALL('fact_hrcontracts'),
			                'fact_hrcontracts'[employeeId] = EmpId,
			                'fact_hrcontracts'[startDate] <= SelectedEndDate,
			                OR(
			                    ISBLANK('fact_hrcontracts'[endDate]),
			                    'fact_hrcontracts'[endDate] >= SelectedStartDate
			                )
			            )
			        ) > 0
			    RETURN IF(HasContract, 1, 0)
			)
		formatString: 0
		lineageTag: 1ba91a77-6d1c-4aa8-80a4-e13d0c6aa8c2

	measure 'In Dienst' =
			VAR SelectedStartDate = MIN('dim_date'[Date])
			VAR SelectedEndDate = MAX('dim_date'[Date])
			
			RETURN
			IF(
			    ISBLANK(SelectedStartDate),
			    BLANK(),
			    VAR NewEmployees =
			        SUMMARIZE(
			            FILTER(
			                'bridge_employees',
			                [Historical Employee Active] = 1 &&
			                'bridge_employees'[EmployeeStartDate] >= SelectedStartDate &&
			                'bridge_employees'[EmployeeStartDate] <= SelectedEndDate &&
			                NOT(ISBLANK('bridge_employees'[EmployeeStartDate]))
			            ),
			            'bridge_employees'[FullName]
			        )
			
			    RETURN COUNTROWS(NewEmployees)
			)
		formatString: 0
		lineageTag: 3dc84e17-8c30-4ca8-b697-ad9853baa622

	measure 'Uit Dienst' =
			VAR SelectedStartDate = MIN('dim_date'[Date])
			VAR SelectedEndDate = MAX('dim_date'[Date])
			RETURN
			IF(
			    ISBLANK(SelectedStartDate),
			    0,
			    VAR LeftEmployeeIds =
			        FILTER(
			            ALL('bridge_employees'[employeeId]),
			            VAR CurrentEmpId = 'bridge_employees'[employeeId]
			            VAR HasEndInPeriod =
			                CALCULATE(
			                    COUNTROWS('bridge_employees'),
			                    'bridge_employees'[employeeId] = CurrentEmpId,
			                    NOT(ISBLANK('bridge_employees'[EmployeeEndDate])),
			                    'bridge_employees'[EmployeeEndDate] >= SelectedStartDate,
			                    'bridge_employees'[EmployeeEndDate] <= SelectedEndDate
			                ) > 0
			            RETURN HasEndInPeriod
			        )
			
			    RETURN COUNTROWS(LeftEmployeeIds)
			)
		formatString: 0
		lineageTag: 96a21adc-7044-415c-9f08-2de4448bdcee

