table dim_date
	lineageTag: 353870a1-412e-4d6b-9050-f1dd571fa80e

	measure 'Current Date' = TODAY()
		formatString: General Date
		lineageTag: b8c92a47-32b7-46fb-9930-774eefe7f7d8

	measure 'Is Tot Huidige Maand' =
			VAR _Today = TODAY ()
			VAR _CurrentYear = YEAR ( _Today )
			VAR _CurrentMonth = MONTH ( _Today )
			VAR _MaxYear = MAX ( 'dim_date'[YearISO] )
			VAR _MaxMonth = MAX ( 'dim_date'[Month] )
			RETURN
			    IF (
			        NOT HASONEVALUE ( 'dim_date'[MonthName] )
			            || _MaxYear < _CurrentYear
			            || ( _MaxYear = _CurrentYear && _MaxMonth <= _CurrentMonth ),
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 85ee35c0-d863-444b-8ea5-44a508771103

	column Date
		dataType: dateTime
		lineageTag: 04890a5a-171c-4dc3-a2e2-76c4524d143d
		sourceColumn: Date

	column DateString
