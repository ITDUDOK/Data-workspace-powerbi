	measure TotaleOmzetExBTW_Bediening = ```
			
			VAR ValidTickets = 
			    INTERSECT(
			        VALUES(sales[TicketKey]),
			        VALUES(payments[TicketKey])
			    )
			RETURN
			CALCULATE(
			    SUM(sales[LineTotalEx]),
			    sales[TicketKey] IN ValidTickets,
			    FILTER(
			        ALL(product_dedup[GroupKey]),
			        product_dedup[GroupKey] = "3300845575733255" ||  -- DRANKEN HOOG
			        product_dedup[GroupKey] = "3300738201550851" ||  -- DRANKEN LAAG  
			        product_dedup[GroupKey] = "3300845575733258" ||  -- GEBAK
			        product_dedup[GroupKey] = "3300845575733257" ||  -- PATISSERIE
			        product_dedup[GroupKey] = "3300832690831364" ||  -- NON FOOD HOOG
			        -- Wine subcategories
			        product_dedup[GroupKey] = "3300738201550868" ||  -- Mousserend
			        product_dedup[GroupKey] = "3300738201550866" ||  -- Rode wijn
			        product_dedup[GroupKey] = "3300738201550867" ||  -- Rose wijn  
			        product_dedup[GroupKey] = "3300738201550865" ||  -- Witte wijn
			        -- Spirits subcategories
			        product_dedup[GroupKey] = "3300738201550872" ||  -- Aperitieven
			        product_dedup[GroupKey] = "3300738201550875" ||  -- Binnenlands Gedestilleerd
			        product_dedup[GroupKey] = "3300738201550876" ||  -- Buitenlands Gedestilleerd
			        product_dedup[GroupKey] = "3300738201550879" ||  -- Digestieven
			        product_dedup[GroupKey] = "3300738201550878" ||  -- Likeuren
