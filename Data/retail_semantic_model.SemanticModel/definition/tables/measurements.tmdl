	measure TotaleOmzetincBTW = ```
			
			VAR ValidTickets = 
			    INTERSECT(
			        VALUES(sales[TicketKey]),
			        VALUES(payments[TicketKey])
			    )
			RETURN
			CALCULATE(
			    SUM(sales[LineTotalInc]),
			    sales[TicketKey] IN ValidTickets
			)
			```
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		lineageTag: 17bb05ee-59f8-48df-a7f6-59fe290db1fe

	measure TotaleOmzetExBTW =
			
			CALCULATE(
			    SUM(sales[LineTotalEx]),
			    sales[TicketKey] IN VALUES(payments[TicketKey])
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 98919520-8d03-47c4-b7e9-25ae7c0765dc

	measure TotaleOmzetExBTW_PreviousWeek =
			
			CALCULATE(
			    [TotaleOmzetExBTW],
			    DATEADD(dates[Date], -7, DAY)
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 6f6fec2d-4ac3-417e-a9b1-86c29dd75f88

	measure TotaleOmzetExBTW_PercentageChange =
			VAR CurrentWeek = [TotaleOmzetExBTW]
			VAR PreviousWeek = [TotaleOmzetExBTW_PreviousWeek]
			VAR PercentChange = DIVIDE(CurrentWeek - PreviousWeek, PreviousWeek)
			RETURN
			IF(
			    ISBLANK(PercentChange),
			    BLANK(),
			    PercentChange
			)
		formatString: 0%;-0%;0%
		lineageTag: a734d1b2-b4dd-4566-bf21-bd82bef9d9a3

	measure Netto_GewerktUren = ```
			
			VAR UniekeUren = 
			    SUMMARIZE(
			        hours,
			        hours[HourId],
			        "Uren", MAX(hours[HourHours])
			    )
			VAR Result = SUMX(UniekeUren, [Uren])
			RETURN
			    Result * 1.00
			```
		formatString: #,0
		lineageTag: 5c77d38c-e03a-485c-b900-8f925345a2fa

	measure LabourCost = ```
			
			VAR UniekeUren =
			    SUMMARIZE(
			        FILTER(
			            hours,
			            hours[HourHours] > 0
			        ),
			        hours[HourId],
			        hours[CardId],
			        hours[HourOfficeId],
			        "Uren", MAX(hours[HourHours])
			    )
			VAR HoursWithRates = 
			    ADDCOLUMNS(
			        UniekeUren,
			        "SalaryRate", 
			        VAR CurrentOffice = [HourOfficeID]
			        VAR CurrentCard = [CardID]
			        RETURN
			        MAXX(
			            FILTER(
			                staff,
			                staff[OfficeId] = CurrentOffice &&
			                staff[CardId] = CurrentCard
			            ),
			            staff[CardSalaryRate]
			        )
			    )
			RETURN
			    SUMX(
			        HoursWithRates,
			        [Uren] * MAX([SalaryRate], 0)
			    )
			```
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: b1956404-6447-4d28-9376-9fed7284f8d4

	measure LabourCost_PercentageOfRevenue =
			
			DIVIDE([LabourCost], [TotaleOmzetExBTW])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ba8bbf51-0ea9-4749-b50f-b553ad675e0f

	measure LabourCost_Planning = ```
			CALCULATE(SUM(planning[PlanningCosts]),planning[PlanningTypeId] in {"Gepland", "Pool dienst", "Ongeplande dienst"})
			
			```
		lineageTag: 25e6160f-1204-49df-8e10-f3b3a5f68c9f

	measure LabourCost_PreviousWeek = ```
			
			CALCULATE(
			    SUMX( hours,
			        VAR TotalWorkedHours = hours[HourHours]
			        VAR NetHours = TotalWorkedHours
			        VAR CurrentOffice = hours[HourOfficeId]
			        VAR CurrentCard = hours[CardId]
			        VAR HourlyRate = LOOKUPVALUE(
			            staff[CardSalaryRate], 
			            staff[OfficeId], CurrentOffice,
			            staff[CardId], CurrentCard
			            )
			        RETURN
			        NetHours * HourlyRate
			    ),
			    DATEADD(dates[Date], -7, DAY)
			)
			```
		formatString: 0
		lineageTag: 4ac7da4a-d833-4069-a4e8-81978cc62cc0

	measure LabourCost_PercentageChange =
			
			VAR CurrentWeek = [LabourCost]
			VAR PreviousWeek = [LabourCost_PreviousWeek]
			Var PercentChange = DIVIDE(CurrentWeek - PreviousWeek, PreviousWeek)
			
			RETURN
			IF(
			    ISBLANK(PercentChange),
			    BLANK(),
			    PercentChange
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 88abddb6-8da6-4d58-a091-b6aac7c15e74

