			)
			```
		lineageTag: 7c73c6b2-94b6-4cbd-a116-89c73bcc60f1

	measure TotaleOmzetExBTWChocolade =
			
			CALCULATE(
			    SUM(sales[LineTotalEx]),
			    KEEPFILTERS(sales[TicketKey] IN VALUES(payments[TicketKey])),
			    product_dedup[GroupName] = "Chocolade"
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 433bc81f-c573-40e8-9755-b0f9057b2ca9

	measure Product_Sum_Quantity_Chocolade =
			
			CALCULATE(
			    [Product_Sum_Quantity],
			    product_dedup[GroupName] = "Chocolade"
			)
		formatString: 0
		lineageTag: f17bd039-e49e-4c94-b687-ae6b066bb3b0

	measure Debug_AllHours =
			
			SUM(planning[PlanningHours])
		lineageTag: 9f8db110-d10d-4c85-b772-f66c21552b34

	measure Gerealiseerd =
			
			FORMAT(
			    [Netto_GewerktUren],
			    "#,##0.00"
			)
		lineageTag: 8bfde319-974b-4da1-bbf9-e9171a90f826

	measure TotalRefund =
			
			CALCULATE(
			    SUMX(
			        DISTINCT(sales[TicketKey]),
			        FIRSTNONBLANK(sales[TicketTotalPrice], 1)
			    ),
			    sales[ActionId] = 15
			)
		formatString: 0
		lineageTag: cca3d46e-414b-4761-bba5-7d89180c2467

	column Column
		isNameInferred
		sourceColumn: [Column]

	partition measurements = calculated
		mode: import
		source = ROW("Column", 1)

