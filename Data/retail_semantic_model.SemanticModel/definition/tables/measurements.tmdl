	measure TotaleOmzetExBTW_Cumulative =
			
			IF(NOT(ISBLANK([TotaleOmzetExBTW])),
			    CALCULATE([TotaleOmzetExBTW],
			        FILTER(ALLSELECTED(time), time[Hour] <= MAX(time[Hour]))
			    )
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 85fd6ccf-a87d-4fa2-915e-9a85ef991635

