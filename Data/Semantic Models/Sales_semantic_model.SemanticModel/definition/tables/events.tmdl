table events
	lineageTag: 9a885ff1-d1f4-470f-94c6-db639d30ad0a
	sourceLineageTag: [dbo].[events]

	measure Event_url_formatted = SELECTEDVALUE('events'[Url])
		lineageTag: 39b9d35a-75d1-47aa-9d7a-f2aa90fd44b9

	measure 'Voorcalculatie Omzet' =
			IF(ISINSCOPE(GLTransactions[InvoiceNumber]) || ISINSCOPE(GLTransactions[Description]) || ISINSCOPE(GLTransactions[Document]) || ISINSCOPE(GLTransactions[OfficialInvoiceNumber]), BLANK(),
			CALCULATE(    VAR ProductOmzet = SUM(event_product_lines[TotalPriceExclVat])    VAR PackageOmzet = IF(ISFILTERED(product_categories[CategoryName]), 0, SUM(event_package_lines[PackageTotalPriceExclVat]))    RETURN ProductOmzet + PackageOmzet,    FILTER(events, events[HeeftGLRegistratie] = TRUE()))
			)
		formatString: €#,##0
		lineageTag: 6cc35c2c-be51-47e4-b3ae-e9f4f528c066

	measure 'Voorcalculatie Kosten' =
			IF(ISINSCOPE(GLTransactions[InvoiceNumber]) || ISINSCOPE(GLTransactions[Description]) || ISINSCOPE(GLTransactions[Document]) || ISINSCOPE(GLTransactions[OfficialInvoiceNumber]), BLANK(),
			CALCULATE(    SUMX(event_product_lines, event_product_lines[CostPrice] * event_product_lines[Amount]),    FILTER(events, events[HeeftGLRegistratie] = TRUE()))
			)
		formatString: €#,##0
		lineageTag: 39297a0a-254c-42a6-a596-bf6609efe125

	measure 'Voorcalculatie Marge %' = DIVIDE([Voorcalculatie Omzet] - [Voorcalculatie Kosten], [Voorcalculatie Omzet])
		formatString: 0.0%
		lineageTag: 70c2b5d0-7137-442b-987f-983d319ab9b9

	measure 'Nacalculatie Omzet' = CALCULATE(    -SUM(GLTransactions[AmountDC]),    GLAccounts[Type] = 110,    FILTER(events, events[HeeftGLRegistratie] = TRUE()))
		formatString: €#,##0
		lineageTag: 2897bdc6-1076-4163-92b7-d413893d4ec7

	measure 'Nacalculatie Kosten' = CALCULATE(    SUM(GLTransactions[AmountDC]),    GLAccounts[Type] IN {111, 121, 122, 125},    FILTER(events, events[HeeftGLRegistratie] = TRUE()))
		formatString: €#,##0
		lineageTag: 971c611d-5285-4a62-8d21-b287ea043b22

	measure 'Nacalculatie Marge %' = DIVIDE([Nacalculatie Omzet] - [Nacalculatie Kosten], [Nacalculatie Omzet])
		formatString: 0.0%
		lineageTag: 179a0119-8021-4f40-b85c-cf45e75befbb

	measure 'Verschil €' = ([Nacalculatie Omzet] - [Nacalculatie Kosten]) - ([Voorcalculatie Omzet] - [Voorcalculatie Kosten])
		formatString: €#,##0
		lineageTag: be85ff9c-984b-4ae2-9bb9-2249140cc776

	measure 'Verschil %' = DIVIDE([Verschil €], ABS([Voorcalculatie Omzet] - [Voorcalculatie Kosten]))
		formatString: 0.0%
		lineageTag: 683516ae-5659-4d3c-a743-95166fd3c7af

	measure 'Heeft GL Registratie' = IF(MAX(events[HeeftGLRegistratie]) = TRUE(), 1, 0)
		formatString: 0
		lineageTag: 84e136a5-693c-4702-aa6c-df8df02f6572

