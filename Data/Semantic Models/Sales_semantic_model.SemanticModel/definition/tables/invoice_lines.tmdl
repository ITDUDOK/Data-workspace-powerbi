table invoice_lines
	lineageTag: 0488bd87-42c7-4345-ad76-c50e484654cc
	sourceLineageTag: [dbo].[invoice_lines]

	measure 'Gefactureerd (op factuurdatum)' =
			CALCULATE(
			    SUM(invoice_lines[TotalPriceExclVat]),
			    USERELATIONSHIP(invoices[DateSentDate], dates[Date])
			)
		formatString: \€\ #,0
		lineageTag: 12419604-f2af-4090-be0d-218d6b13febe

