table measurements
	lineageTag: 43bb2548-ecb3-4791-ad49-8133db1e1571
	sourceLineageTag: [dbo].[measurements]

	measure Event_URL =
			IF (
			    NOT ISEMPTY ( 'events' ),
			    IF (
			        ISINSCOPE ( 'events'[EventLabel] ),
			        SELECTEDVALUE ( 'events'[Url] )
			    )
			)
		lineageTag: 0a794ef5-ecdb-4b53-8d59-233baebf4c76

	measure Event_status =
			IF (
			    NOT ISEMPTY ( 'events' ),
			    IF (
			        ISINSCOPE ( 'events'[EventLabel] ),
			        SELECTEDVALUE ( 'events'[Status] )
			    )
			)
		lineageTag: 1059f79f-6b4c-4447-978e-24e8108dac9c

	measure Event_id = CALCULATE(DISTINCTCOUNT('events'[EventId]), ALL('events'[BookingId]))
		formatString: #,0
		lineageTag: 1a538641-6d66-4a96-821e-2727a04521da

		changedProperty = FormatString

	measure Event_planner = TRIM ( SELECTEDVALUE ( 'events'[PlannerFirstName] ) & " " & SELECTEDVALUE ( 'events'[PlannerLastName] ) )
		lineageTag: a6c9463c-3f45-43dc-8fac-634c77e6127c

	measure total_costprice =
			SUMX (
			    'event_product_lines',
			    'event_product_lines'[Amount] * 'event_product_lines'[CostPrice]
			)
		lineageTag: ec897701-b84f-46d3-a454-09161ae6e9f8

	measure Marge =
			VAR Revenue = SUM ( 'event_product_lines'[TotalPriceExclVat] )
			VAR Cost    = [total_costprice]
			RETURN
			    DIVIDE ( Revenue - Cost, Revenue )
		formatString: 0%;-0%;0%
		lineageTag: f5953bfa-b10b-45fc-9d56-42877c7efae6

		changedProperty = FormatString

	measure Marge2 =
			Var revenue = CALCULATE(SUM('event_product_lines'[TotalPriceExclVat]))
			Var cost    = CALCULATE(SUM('event_product_lines'[CostPrice]))
			RETURN
			DIVIDE(cost, revenue)
		lineageTag: 14defbb5-0b63-4482-8829-131172f3a03a

	measure 'Datum event' =
			IF (
			    NOT ISEMPTY ( 'events' ),
			    IF (
			        ISINSCOPE ( 'events'[EventLabel] ),
			        FORMAT (
			            SELECTEDVALUE ( 'events'[EventDate] ),
			            "ddd dd mmm yyyy",
			            "nl-NL"
			        )
			    )
			)
		lineageTag: da4eb976-695d-41e6-8464-20e65ec0e30d

	measure Event_rows = COUNTROWS ( VALUES ( 'events'[EventLabel] ) )
		formatString: 0
		lineageTag: d2f0f6ef-75ae-4e85-b243-c651514085d8

	measure 'Total Rows Only' =
			
			IF (
			    HASONEVALUE ( 'events'[EventLabel] ),
			    BLANK (),
			    COUNTROWS ( 'events' )
			)
		lineageTag: f2bbe0a7-dee2-4f38-8ac6-510962eff9d2

	measure omzet/gasten = CALCULATE(DIVIDE(SUM('events'[TotalPriceExclVat]), SUM('events'[Guests])))
		lineageTag: 31b140bf-a929-460a-a7d5-fcc6429a595c

	measure omzet/event = CALCULATE(DIVIDE(SUM('events'[TotalPriceExclVat]), [Event_id]))
		lineageTag: 649ae782-1cec-4ff1-ab6c-e333a2896494

	measure Event_Client =
			IF (
			    NOT ISEMPTY ( 'events' ),
			    IF (
			        ISINSCOPE ( 'events'[EventLabel] ),
			        SELECTEDVALUE ( 'events'[ClientName] )
			    )
			)
		lineageTag: 2ed7a6fc-212d-4688-846e-7478770172ec

		changedProperty = Name

	measure 'Datum factuur' =
			IF (
			    NOT ISEMPTY ( 'invoices' ),
			    IF (
			        ISINSCOPE ( 'events'[EventLabel] ),
			        FORMAT (
			            CALCULATE (
			                MAX ( 'invoices'[DateSentDate] ),
			                TREATAS ( VALUES ( 'invoice_lines'[InvoiceId] ), 'invoices'[InvoiceId] )
			            ),
			            "ddd dd mmm yyyy",
			            "nl-NL"
			        )
			    )
			)
		lineageTag: fa57f147-5199-46fb-894c-0557adf9a90f

	measure 'Aantal aanvragen' = COUNTROWS('events')
		formatString: #,##0
		lineageTag: c13c7584-fa67-4b89-82eb-9f673b8c8ea9

	measure 'Aantal confirmed' = CALCULATE([Aantal aanvragen], events[Status] = "confirmed")
		formatString: #,##0
		lineageTag: 3a65b64e-3450-4a08-afed-a106dcdd554c

	measure 'Aantal cancelled' = CALCULATE([Aantal aanvragen], events[Status] = "cancelled")
		formatString: #,##0
		lineageTag: 36cd2f5d-9f8c-4e71-8d48-dc1caf3cb669

	measure 'Conversie #' = DIVIDE([Aantal confirmed], [Aantal confirmed] + [Aantal cancelled])
		formatString: 0%
		lineageTag: 121e3968-b536-460d-82a2-5b31701e4b9e

	measure Gegund = [Aantal confirmed]
		formatString: #,##0
		lineageTag: e212c2ac-272c-4b5d-8117-85b97bd2f123

	measure 'Gem. Omzet' = CALCULATE(AVERAGE(events[TotalPriceExclVat]), events[Status] = "confirmed")
		formatString: € #,##0
		lineageTag: a4074622-87ad-458b-bddb-01b6c84d182f

	measure 'Totaal omzet (confirmed)' = CALCULATE(SUM(events[TotalPriceExclVat]), events[Status] = "confirmed")
		formatString: € #,##0
		lineageTag: 59d1263b-d9a2-428d-a587-5763422e1cae

	measure 'Omzet ex BTW' = SUM(events[TotalPriceExclVat])
		formatString: € #,##0
		lineageTag: 0d09a763-b1fe-4ada-ad18-ae676d97a6d5

	measure 'Tijd per aanvraag (uur)' = IF([Aantal aanvragen] = 0, BLANK(), ROUND(DIVIDE(1700, [Aantal aanvragen]), 0))
		formatString: #,##0
		lineageTag: d50f1aff-96ba-4aab-b6be-f6a0c3f214a8

	column Column
		dataType: string
		lineageTag: 4668f553-0c39-49ab-9531-74c1482cbc47
		sourceLineageTag: Column
		summarizeBy: none
		sourceColumn: Column

		annotation SummarizationSetBy = Automatic

	partition measurements = entity
		mode: directLake
		source
			entityName: measurements
			schemaName: dbo
			expressionSource: 'DirectLake - lh_dudodata_gold_powerbi'

