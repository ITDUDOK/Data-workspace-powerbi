	measure 'VK Contracturen' =
			VAR MinDate = MIN(dates[Date])
			VAR MaxDate = MAX(dates[Date])
			VAR CurrentOffices = VALUES(offices[OfficeId])
			VAR SourceOffices =
			    CALCULATETABLE(
			        VALUES(map_vkoffice[SourceOfficeId]),
			        TREATAS(CurrentOffices, map_vkoffice[TargetOfficeId])
			    )
			RETURN
			IF(
			    ISBLANK(MinDate),
			    BLANK(),
			    CALCULATE(
			        SUMX(
			            employees_enriched,
			            VAR WeeklyHours = employees_enriched[ContractHours]
			            VAR EmpStart = employees_enriched[EmployeeStartDate]
			            VAR EmpEnd   = COALESCE(employees_enriched[EmployeeEndDate], MaxDate)
			            VAR OverlapStart = MAX(EmpStart, MinDate)
			            VAR OverlapEnd   = MIN(EmpEnd,   MaxDate)
			            VAR OverlapDays  =
			                IF(
			                    NOT ISBLANK(EmpStart) && OverlapStart <= OverlapEnd,
			                    OverlapEnd - OverlapStart + 1,
			                    0
			                )
			            RETURN COALESCE(WeeklyHours, 0) * DIVIDE(OverlapDays, 7, 0)
			        ),
			        TREATAS(SourceOffices, employees_enriched[OfficeId]),
			        REMOVEFILTERS(offices)
			    )
			)
		formatString: #,0
		lineageTag: c40ae1d2-150d-47bc-aae2-aa2706075949

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'VK Ziekteuren' =
			VAR MinDate = MIN(dates[Date])
			VAR MaxDate = MAX(dates[Date])
			VAR CurrentOffices = VALUES(offices[OfficeId])
			VAR SourceOffices =
			    CALCULATETABLE(
			        VALUES(map_vkoffice[SourceOfficeId]),
			        TREATAS(CurrentOffices, map_vkoffice[TargetOfficeId])
			    )
			VAR RelevantCardIDs =
			    CALCULATETABLE(
			        VALUES(employees_enriched[CardId]),
			        TREATAS(SourceOffices, employees_enriched[OfficeId]),
			        REMOVEFILTERS(offices)
			    )
			RETURN
			IF(
			    ISBLANK(MinDate),
			    BLANK(),
			    CALCULATE(
			        SUMX(
			            FILTER(
			                sickness,
			                sickness[CardId] IN RelevantCardIDs
			                    && NOT ISBLANK(sickness[SicknessEnd])
			                    && sickness[SicknessEnd] >= MinDate
			                    && sickness[SicknessEnd] <= MaxDate
			            ),
			            sickness[SicknessHours]
			        ),
			        REMOVEFILTERS(dates),
			        REMOVEFILTERS(offices)
			    )
			)
		formatString: #,0
		lineageTag: 8fd72edf-8b2b-41b6-9c89-8a9703cd82f6

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'VK Verzuim Uren %' = DIVIDE([VK Ziekteuren], [VK Contracturen], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: afa39010-6967-4d81-869e-44dc445fa25b

	measure 'VK Bruto Loonkosten' =
			VAR SelectedYearMonths =
			    CALCULATETABLE(SUMMARIZE(dates, dates[Year], dates[Month]))
			VAR CurrentOffices = VALUES(offices[OfficeId])
			VAR SourceOffices =
			    CALCULATETABLE(
			        VALUES(map_vkoffice[SourceOfficeId]),
			        TREATAS(CurrentOffices, map_vkoffice[TargetOfficeId])
			    )
			VAR Divisions =
			    CALCULATETABLE(
			        VALUES(map_division_office[Division]),
			        TREATAS(SourceOffices, map_division_office[OfficeID])
			    )
			VAR AccountIDs =
			    CALCULATETABLE(
			        VALUES(GLAccounts[ID]),
			        GLAccounts[Code] >= "4000",
			        GLAccounts[Code] <= "4019"
			    )
			VAR DivisionTotal =
			    CALCULATE(
			        SUM(GLTransactions[AmountDC]),
			        TREATAS(SelectedYearMonths, GLTransactions[ReportingYear], GLTransactions[ReportingPeriod]),
			        TREATAS(AccountIDs, GLTransactions[GLAccount]),
			        TREATAS(Divisions,  GLTransactions[Division]),
			        REMOVEFILTERS(dates),
			        REMOVEFILTERS(offices)
			    )
			VAR FilteredWeight = [VK Loonkosten Gewicht]
			VAR TotalWeight =
			    CALCULATE(
			        [VK Loonkosten Gewicht],
			        REMOVEFILTERS(employees_enriched[ManagerFullName]),
			        REMOVEFILTERS(employees_enriched[FunctionName]),
			        REMOVEFILTERS(employees_enriched[IsActief]),
			        REMOVEFILTERS(employees_enriched[FullName])
			    )
			RETURN
			    DivisionTotal * DIVIDE(FilteredWeight, TotalWeight, 0)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 9989fffa-33c1-4ddc-8d79-b6ca942ddf9c

