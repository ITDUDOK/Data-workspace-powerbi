	measure Tooltip_HR_Overzicht =
			
			VAR SelectedYear =
			    COALESCE(
			        SELECTEDVALUE(dates[Year]),
			        YEAR(TODAY())
			    )
			
			VAR SelectedMonth =
			    COALESCE(
			        SELECTEDVALUE(dates[Month]),
			        MONTH(TODAY())
			    )
			
			VAR VorigeMaandDate =
			    EDATE(
			        DATE(SelectedYear, SelectedMonth, 1),
			        -1
			    )
			
			RETURN
			    "Toelichting HR-overzicht"
			        & UNICHAR(10) & UNICHAR(10)
			        & "De groene kolommen zijn gebaseerd op data van de vorige maand: "
			        & FORMAT(VorigeMaandDate, "mmmm yyyy")
			        & "."
			        & UNICHAR(10) & UNICHAR(10)
			        & "Gewerkte uren MA toont de totaal gewerkte uren in de vorige maand."
			        & UNICHAR(10)
			        & "Eerst worden echte geregistreerde uren uit hours gebruikt."
			        & UNICHAR(10)
			        & "Als deze ontbreken, worden calculated contract hours uit hours_summary gebruikt."
			        & UNICHAR(10) & UNICHAR(10)
			        & "Werklocatie wordt bepaald op basis van de locatie waar de medewerker in de geselecteerde maand het meeste heeft gewerkt."
			        & UNICHAR(10)
			        & "Als er geen uren zijn in de geselecteerde maand, wordt teruggevallen op de vaste werklocatie."
			        & UNICHAR(10) & UNICHAR(10)
			        & "Business line wordt bepaald op basis van de berekende werklocatie, niet op basis van de contractlocatie."
		lineageTag: 4d308355-ba7d-4a6f-b1ac-f6407698d7a9

	measure Vaste_Medewerkers =
			
			VAR SelectedOffice = SELECTEDVALUE(offices[OfficeId])
			RETURN
			IF(
			    ISBLANK(SelectedOffice),
			    CALCULATE(
			        DISTINCTCOUNT(hours_summary[CardId]),
			        hours_summary[EmployeeType] = "Vast",
			        hours_summary[HourHours] > 0
			    ),
			    CALCULATE(
			        DISTINCTCOUNT(hours_summary[CardId]),
			        hours_summary[EmployeeType] = "Vast",
			        hours_summary[HourHours] > 0,
			        hours_summary[WorkOfficeId] = SelectedOffice
			    )
			)
		lineageTag: e5a1f5f1-a07c-40b8-b372-75c906b17a97

	measure Flex_Medewerkers =
			
			VAR SelectedOffice = SELECTEDVALUE(offices[OfficeId])
			RETURN
			IF(
			    ISBLANK(SelectedOffice),
			    CALCULATE(
			        DISTINCTCOUNT(hours_summary[CardAccountantNumber]),
			        hours_summary[EmployeeType] IN {"Flex", "Temporary", "Zero Hours"},
			        NOT ISBLANK(hours_summary[CardAccountantNumber])
			    ),
			    CALCULATE(
			        DISTINCTCOUNT(hours_summary[CardAccountantNumber]),
			        hours_summary[EmployeeType] IN {"Flex", "Temporary", "Zero Hours"},
			        hours_summary[WorkOfficeId] = SelectedOffice,
			        NOT ISBLANK(hours_summary[CardAccountantNumber])
			    )
			)
		lineageTag: cb4170be-b2f8-4332-b4c5-8b4f971602bb

	measure Werklocatie_MA = ```
			
			VAR HuidigCardID = [CardID_MA_Gekozen_OpNaam]
			VAR SelectedYear = COALESCE(SELECTEDVALUE(dates[Year]), YEAR(TODAY()))
			VAR SelectedMonth = COALESCE(SELECTEDVALUE(dates[Month]), MONTH(TODAY()))
			VAR VorigeMaandDate = EDATE(DATE(SelectedYear, SelectedMonth, 1), -1)
			VAR VorigeYear = YEAR(VorigeMaandDate)
			VAR VorigeMonth = MONTH(VorigeMaandDate)
			VAR HuidigEmployeeId =
			    CALCULATE(
			        SELECTEDVALUE(employees_enriched[EmployeeId]),
			        employees_enriched[CardId] = HuidigCardID
			    )
			VAR WerklocatieViaUren =
			    CALCULATE(
			        SELECTEDVALUE(employee_worklocation_monthly[WerklocatieOfficeName]),
			        REMOVEFILTERS(employee_worklocation_monthly),
			        REMOVEFILTERS(dates),
			        employee_worklocation_monthly[EmployeeId] = HuidigEmployeeId,
			        YEAR(employee_worklocation_monthly[YearMonth]) = VorigeYear,
			        MONTH(employee_worklocation_monthly[YearMonth]) = VorigeMonth
			    )
			-- Fallback naar contractlocatie als er geen uren zijn geregistreerd in de vorige maand
			VAR ContractOfficeId =
			    CALCULATE(
			        SELECTEDVALUE(employees_enriched[OfficeId]),
			        employees_enriched[CardId] = HuidigCardID
			    )
			VAR WerklocatieViaContract =
			    LOOKUPVALUE(offices[OfficeName], offices[OfficeId], ContractOfficeId)
			RETURN
			    IF(
			        ISBLANK(HuidigCardID),
			        BLANK(),
			        IF(NOT ISBLANK(WerklocatieViaUren), WerklocatieViaUren, WerklocatieViaContract)
			    )
			
			```
		lineageTag: 56d89e50-e215-49b3-baa3-6f86d68e8117

	measure Tevredenheidscijfer_MA =
			VAR HuidigCardID = [CardID_MA_Gekozen_OpNaam]
			VAR HuidigEmployeeId =
			    CALCULATE(
			        SELECTEDVALUE(employees_enriched[EmployeeId]),
			        employees_enriched[CardId] = HuidigCardID
			    )
			VAR SelectedYear = COALESCE(SELECTEDVALUE(dates[Year]), YEAR(TODAY()))
			VAR SelectedMonth = COALESCE(SELECTEDVALUE(dates[Month]), MONTH(TODAY()))
			VAR VorigeMaandDate = EDATE(DATE(SelectedYear, SelectedMonth, 1), -1)
			VAR VorigeStart = DATE(YEAR(VorigeMaandDate), MONTH(VorigeMaandDate), 1)
			VAR VorigeEind = EOMONTH(VorigeMaandDate, 0)
			VAR RuweScore =
			    IF(
			        ISBLANK(HuidigCardID),
			        BLANK(),
			        CALCULATE(
			            AVERAGE(satisfaction[Satisfaction]),
			            REMOVEFILTERS(satisfaction),
			            REMOVEFILTERS(dates),
			            satisfaction[EmployeeId] = HuidigEmployeeId,
			            satisfaction[SurveyDate] >= VorigeStart,
			            satisfaction[SurveyDate] <= VorigeEind
			        )
			    )
			RETURN
			IF(ISBLANK(RuweScore), BLANK(), (RuweScore - 1) * 2.5)
		lineageTag: 90c820ae-c043-4189-99a1-1ca4dca328fe

	measure Saldo_Compensatieuren =
			
			VAR CurrentCardIDs = VALUES(employees_enriched[CardId])
