	measure Ziekteverzuim_Percentage_Locatie = ```
			
			VAR GekozenData = VALUES(dates[Date])
			VAR HeeftSelectie = NOT ISEMPTY(GekozenData)
			VAR MinDate = IF(HeeftSelectie, MINX(GekozenData, dates[Date]), TODAY())
			VAR MaxDate = IF(HeeftSelectie, MAXX(GekozenData, dates[Date]), TODAY())
			
			VAR ZiekteUren = 
			    CALCULATE(
			        SUM(sickness[SicknessHours]),
			        REMOVEFILTERS(dates),
			        KEEPFILTERS(
			            FILTER(
			                ALL(sickness),
			                sickness[SicknessStart] >= MinDate &&
			                sickness[SicknessStart] <= MaxDate
			            )
			        )
			    )
			
			VAR GewerkteUren = 
			    CALCULATE(
			        SUM(hours[HourHours]),
			        REMOVEFILTERS(dates),
			        KEEPFILTERS(
			            FILTER(
			                ALL(hours),
			                hours[HourDate] >= MinDate &&
			                hours[HourDate] <= MaxDate
			            )
			        )
			    )
			
			RETURN
			IF(
			    GewerkteUren > 0,
			    DIVIDE(ZiekteUren, GewerkteUren, 0) * 100,
			    0
			)
			```
		lineageTag: fd7ae8b4-d3ac-4405-b3e4-47fc9f873cd1

	measure Ziekteverzuim_Percentage = ```
			
			VAR GekozenData = VALUES(dates[Date])
			VAR HeeftSelectie = NOT ISEMPTY(GekozenData)
			VAR MinDate = IF(HeeftSelectie, MINX(GekozenData, dates[Date]), TODAY())
			VAR MaxDate = IF(HeeftSelectie, MAXX(GekozenData, dates[Date]), TODAY())
			
			VAR ZiekteUren = 
			    CALCULATE(
			        SUMX(
			            sickness,
			            VAR SicknessStart = sickness[SicknessStart]
			            VAR SicknessEnd = IF(ISBLANK(sickness[SicknessEnd]), TODAY(), sickness[SicknessEnd])
			            VAR OverlapStart = MAX(SicknessStart, MinDate)
			            VAR OverlapEnd = MIN(SicknessEnd, MaxDate)
			            
			            RETURN
			            IF(
			                OverlapStart <= OverlapEnd,  -- There is overlap
			                sickness[SicknessHours] * 
			                DIVIDE(OverlapEnd - OverlapStart + 1, SicknessEnd - SicknessStart + 1, 0),
			                0
			            )
			        ),
			        REMOVEFILTERS(dates)
			    )
			
			VAR GewerkteUren = 
			    CALCULATE(
			        SUM(hours[HourHours]),
			        REMOVEFILTERS(dates),
			        KEEPFILTERS(
			            FILTER(
			                ALL(hours),
			                hours[HourDate] >= MinDate &&
			                hours[HourDate] <= MaxDate
			            )
			        )
			    )
			
			RETURN
			IF(
			    GewerkteUren > 0,
			    DIVIDE(ZiekteUren, GewerkteUren, 0),
			    0
			)
			```
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: d859f459-d733-45d1-8a45-55cc5d34a3f2

