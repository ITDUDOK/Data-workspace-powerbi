	measure Werklocatie = ```
			
			VAR GekozenData = VALUES(dates[Date])
			VAR HeeftSelectie = NOT ISEMPTY(GekozenData)
			VAR MinDate = IF(HeeftSelectie, MINX(GekozenData, dates[Date]), TODAY())
			VAR MaxDate = IF(HeeftSelectie, MAXX(GekozenData, dates[Date]), TODAY())
			VAR HuidigCardName = SELECTEDVALUE(hours[CardName])
			VAR UrenPerLocatie =
			    FILTER(
			        ADDCOLUMNS(
			            CALCULATETABLE(
			                VALUES(hours[HourOfficeId]),
			                REMOVEFILTERS(dates),
			                REMOVEFILTERS(hours),
			                hours[CardName] = HuidigCardName,
			                hours[HourDate] >= MinDate,
			                hours[HourDate] <= MaxDate
			            ),
			            "TotaalUren", CALCULATE(
			                SUM(hours[HourHours]),
			                REMOVEFILTERS(dates),
			                hours[CardName] = HuidigCardName,
			                hours[HourDate] >= MinDate,
			                hours[HourDate] <= MaxDate
			            )
			        ),
			        [TotaalUren] > 0
			    )
			VAR MaxUren = MAXX(UrenPerLocatie, [TotaalUren])
			VAR TopOfficeID = 
			    MAXX(
			        FILTER(UrenPerLocatie, [TotaalUren] = MaxUren),
			        hours[HourOfficeId]
			    )
			RETURN
			    IF(
			        NOT ISBLANK(HuidigCardName),
			        LOOKUPVALUE(
			            offices[OfficeName],
			            offices[OfficeId],
			            TopOfficeID
			        )
			    )
			```
		lineageTag: 96085676-3b1b-4c45-9b71-6bd265f1fa49

	measure Ziekmeldingen_6M =
			VAR HuidigCardID = [CardID_MA_Gekozen_OpNaam]
			VAR SelectedYear = COALESCE(SELECTEDVALUE(dates[Year]), YEAR(TODAY()))
			VAR SelectedMonth = COALESCE(SELECTEDVALUE(dates[Month]), MONTH(TODAY()))
			VAR VorigeMaandEinde = EOMONTH(DATE(SelectedYear, SelectedMonth, 1), -1)
			VAR Grens = EDATE(VorigeMaandEinde, -6)
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(sickness[MeldingId]),
			        REMOVEFILTERS(dates),
			        sickness[CardId] = HuidigCardID,
			        sickness[SicknessStart] >= Grens
