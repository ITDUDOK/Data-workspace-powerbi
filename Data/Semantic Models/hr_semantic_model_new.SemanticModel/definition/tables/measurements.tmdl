	measure GemiddeldeDiensttijd = ```
			
			VAR GekozenEindDatum = MAX(dates[Date])  -- laatste datum in selectie (einde van de periode)
			RETURN
			IF(
			    ISBLANK(GekozenEindDatum),
			    BLANK(),
			    AVERAGEX(
			        FILTER(
			            employments,  -- vervang met de naam van je tabel met contracten
			            employments[endDate] <= GekozenEindDatum
			            && (ISBLANK(employments[endDate]) || employments[endDate] >= GekozenEindDatum)
			        ),
			        -- Bereken diensttijd: verschil tussen gekozen einddatum en startdatum
			        DATEDIFF(employments[startDate], GekozenEindDatum, YEAR)  
			        -- Je kan DAY vervangen door YEAR als je gemiddelde in jaren wil
			    )
			)
			
			```
		lineageTag: 1662f18b-b696-45a0-8dcf-cae8e05fe9b9

