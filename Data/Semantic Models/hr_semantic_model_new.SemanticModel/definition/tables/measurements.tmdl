	measure 'VK Diag BRIDGE Match' = ```
			
			VAR CID = 
			    CALCULATE(
			        MAX(sickness[CardId]),
			        ALLEXCEPT(sickness, sickness[MeldingId])
			    )
			VAR OfficeIDs = 
			    CALCULATETABLE(
			        VALUES(employees_enriched[OfficeID]),
			        FILTER(
			            ALL('employees_enriched'),
			            employees_enriched[CardId] = CID
			        )
			    )
			VAR MatchCount = COUNTROWS(OfficeIDs)
			VAR OfficeNames = 
			    CONCATENATEX(
			        CALCULATETABLE(
			            VALUES(offices[OfficeName]),
			            TREATAS(OfficeIDs, offices[OfficeId])
			        ),
			        offices[OfficeName],
			        ", "
			    )
			RETURN
			    "CID=" & COALESCE(FORMAT(CID, "0"), "BLANK") &
			    " | " &
			    IF(
			        COALESCE(MatchCount, 0) = 0,
			        "❌ GEEN MATCH",
			        "✓ " & OfficeNames
			    )
			```
