	measure EndDatum_Actief_Filter_MA =
			
			VAR SelectedYear  = COALESCE( SELECTEDVALUE( dates[YearISO] ), YEAR( TODAY() ) )
			VAR SelectedMonth = COALESCE( SELECTEDVALUE( dates[Month] ),  MONTH( TODAY() ) )
			VAR MaandStart    = DATE( SelectedYear, SelectedMonth, 1 )
			VAR MaandEind     = EOMONTH( MaandStart, 0 )
			
			VAR MaxEinde =
			    CALCULATE(
			        MAX( employees_enriched[EmployeeEndDate] ),
			        ALLEXCEPT( 'employees_enriched', employees_enriched[FullName] )
			    )
			
			VAR MinStart =
			    CALCULATE(
			        MIN( employees_enriched[EmployeeStartDate] ),
			        ALLEXCEPT( 'employees_enriched', employees_enriched[FullName] )
			    )
			
			RETURN
			    IF(
			        -- Startdatum moet vóór of in de geselecteerde maand liggen
			        ( ISBLANK( MinStart ) || MinStart <= MaandEind )
			        -- EN einddatum moet op of na de maandstart liggen (of BLANK = nog actief)
			        && ( ISBLANK( MaxEinde ) || MaxEinde >= MaandStart ),
			        1,
			        BLANK()
			    )
