	measure WL_Werklocatie = ```
			
			VAR GekozenData = VALUES(dates[Date])
			VAR HeeftSelectie = NOT ISEMPTY(GekozenData)
			VAR MinDate = IF(HeeftSelectie, MINX(GekozenData, dates[Date]), TODAY())
			VAR MaxDate = IF(HeeftSelectie, MAXX(GekozenData, dates[Date]), TODAY())
			VAR HuidigCardID =
			    COALESCE(
			        SELECTEDVALUE(employees_enriched[CardId]),
			        SELECTEDVALUE(hours[CardId]),
			        SELECTEDVALUE(hours_summary[CardId])
			    )
			VAR UrenPerLocatie =
			    FILTER(
			        ADDCOLUMNS(
			            CALCULATETABLE(
			                VALUES(hours[HourOfficeId]),
			                REMOVEFILTERS(dates),
			                REMOVEFILTERS(hours),
			                hours[CardId] = HuidigCardID,
			                hours[HourDate] >= MinDate,
			                hours[HourDate] <= MaxDate
			            ),
			            "TotaalUren", CALCULATE(
			                SUM(hours[HourHours]),
			                REMOVEFILTERS(dates),
			                hours[CardId] = HuidigCardID,
			                hours[HourDate] >= MinDate,
			                hours[HourDate] <= MaxDate
			            )
			        ),
			        [TotaalUren] > 0
			    )
			VAR MaxUren = MAXX(UrenPerLocatie, [TotaalUren])
			VAR TopOfficeID = 
			    MAXX(
			        FILTER(UrenPerLocatie, [TotaalUren] = MaxUren),
			        hours[HourOfficeId]
			    )
			RETURN
			    IF(
			        ISBLANK(HuidigCardID),
			        BLANK(),
			        LOOKUPVALUE(
			            offices[OfficeName],
			            offices[OfficeId],
			            TopOfficeID
			        )
			    )
			```
		lineageTag: cfa870e1-f57e-40e5-ba0d-c83d790359c2

