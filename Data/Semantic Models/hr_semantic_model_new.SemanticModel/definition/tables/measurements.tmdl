	measure Werklocatie_Filter_VorigeMaand_MA =
			
			VAR HuidigCardID = SELECTEDVALUE(employees_enriched[CardId])
			
			VAR SelectedYear  = IF(HASONEVALUE(dates[Year]),  VALUES(dates[Year]),  YEAR(TODAY()))
			VAR SelectedMonth = IF(HASONEVALUE(dates[Month]), VALUES(dates[Month]), MONTH(TODAY()))
			VAR VorigeMaand   = EDATE(DATE(SelectedYear, SelectedMonth, 1), -1)
			VAR VorigeYear    = YEAR(VorigeMaand)
			VAR VorigeMonth   = MONTH(VorigeMaand)
			
			-- Bereken TopOfficeID voor deze medewerker in de vorige maand (zelfde logica als Werklocatie_Maandanalyse)
			VAR UrenPerLocatie =
			    ADDCOLUMNS(
			        CALCULATETABLE(
			            VALUES(hours[HourOfficeId]),
			            REMOVEFILTERS(hours),
			            REMOVEFILTERS(dates),
			            hours[CardId] = HuidigCardID,
			            dates[Year]  = VorigeYear,
			            dates[Month] = VorigeMonth
			        ),
			        "TotaalUren", CALCULATE(
			            SUM(hours[HourHours]),
			            REMOVEFILTERS(hours),
			            REMOVEFILTERS(dates),
			            hours[CardId] = HuidigCardID,
			            dates[Year]  = VorigeYear,
			            dates[Month] = VorigeMonth
			        )
			    )
			VAR MaxUren     = MAXX(UrenPerLocatie, [TotaalUren])
			VAR TopOfficeID =
			    MAXX(FILTER(UrenPerLocatie, [TotaalUren] = MaxUren), hours[HourOfficeId])
			
			-- Fallback naar contractlocatie als geen uren
			VAR EffectiefOfficeID =
			    IF(
			        NOT ISBLANK(TopOfficeID),
			        TopOfficeID,
			        SELECTEDVALUE(employees_enriched[OfficeID])
			    )
			
			-- Welke offices heeft de slicer geselecteerd?
			VAR GeselOffices  = VALUES(slicer_werklocatie[OfficeId])
			VAR HeeftSelectie =
			    COUNTROWS(GeselOffices) < COUNTROWS(ALL(slicer_werklocatie[OfficeId]))
			
			RETURN
			    IF(
			        ISBLANK(HuidigCardID),
			        BLANK(),
			        IF(
			            NOT HeeftSelectie,
			            1,
			            IF(CONTAINSROW(GeselOffices, EffectiefOfficeID), 1, BLANK())
			        )
			    )
		formatString: 0
		lineageTag: 9c18b5b7-e74a-4737-b1f1-d0d6411b8c02

	measure DEBUG_CardID_Gekozen =
			
			VAR CurrentName = SELECTEDVALUE( employees_enriched[FullName] )
			VAR SelectedYear  = COALESCE( SELECTEDVALUE( dates[YearISO] ), YEAR( TODAY() ) )
			VAR SelectedMonth = COALESCE( SELECTEDVALUE( dates[Month] ), MONTH( TODAY() ) )
			VAR StartDatum = DATE( SelectedYear, SelectedMonth, 1 )
			VAR EindDatum  = EOMONTH( StartDatum, 0 )
			
			VAR AlleRijen =
			    COUNTROWS( FILTER( ALL( 'employees_enriched' ), employees_enriched[FullName] = CurrentName ) )
			
			VAR OverlapRijen =
			    COUNTROWS(
			        FILTER(
			            ALL( 'employees_enriched' ),
			            employees_enriched[FullName] = CurrentName
			                && COALESCE( employees_enriched[EmployeeStartDate], employees_enriched[CardStart], DATE(1900,1,1) ) <= EindDatum
			                && COALESCE( employees_enriched[EmployeeEndDate],   employees_enriched[CardEnd],   DATE(2099,12,31) ) >= StartDatum
			        )
			    )
			
			VAR GekozenID = [CardID_MA_Gekozen_OpNaam]
			
			RETURN
			    "Naam=" & CurrentName
			    & " | Jaar=" & SelectedYear
			    & " | Maand=" & SelectedMonth
			    & " | AlleRijen=" & AlleRijen
			    & " | OverlapRijen=" & OverlapRijen
			    & " | GekozenCardID=" & COALESCE( FORMAT( GekozenID, "0" ), "BLANK" )
		lineageTag: 7d50f048-66ce-45ff-851d-e25b94c7ee7e

	measure CardID_MA_Gekozen_OpNaam = ```
			
			-- Als de huidige rij al een eigen (niet-genulde) CardId heeft, gebruik die
			-- direct -- veilig en ondubbelzinnig, ongeacht naamgenoten elders in het
			-- model. Alleen als de rij zelf geen CardId heeft (een 'superseded'
			-- contractrecord na de CardId-dedup, zie usp_LoadEmployeesEnriched) valt
			-- deze terug op de oude naam-gebaseerde zoekopdracht, wat bij naamgenoten
			-- nog steeds de verkeerde persoon kan opleveren.
			VAR EigenCardId = SELECTEDVALUE( employees_enriched[CardId] )
			
			VAR CurrentName =
			    SELECTEDVALUE( employees_enriched[FullName] )
			
			VAR SelectedYear  = COALESCE( SELECTEDVALUE( dates[YearISO] ), YEAR( TODAY() ) )
			VAR SelectedMonth = COALESCE( SELECTEDVALUE( dates[Month] ), MONTH( TODAY() ) )
			VAR StartDatum    = DATE( SelectedYear, SelectedMonth, 1 )
			VAR EindDatum     = EOMONTH( StartDatum, 0 )
			VAR Peildatum     = MIN( EindDatum, TODAY() )
			
			VAR CandidateRows =
			    ADDCOLUMNS(
			        FILTER(
			            ALL( 'employees_enriched' ),
			            employees_enriched[FullName] = CurrentName
			        ),
			        "__EffStart",
			            COALESCE(
			                employees_enriched[EmployeeStartDate],
			                employees_enriched[CardStart],
			                DATE( 1900, 1, 1 )
			            ),
			        "__EffEnd",
			            COALESCE(
			                employees_enriched[EmployeeEndDate],
			                employees_enriched[CardEnd],
			                DATE( 2099, 12, 31 )
			            )
			    )
			
			-- Alleen rijen die overlappen met de geselecteerde maand
			VAR OverlappendRows =
			    FILTER(
			        CandidateRows,
			        [__EffStart] <= EindDatum && [__EffEnd] >= StartDatum
			    )
			
			-- Prioriteit: actief op maandstart > actief op peildatum > meest recente start > hoogste CardID
			VAR BestRow =
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            OverlappendRows,
			            "__ActiveAtStart",  IF( [__EffStart] <= StartDatum && [__EffEnd] >= StartDatum, 1, 0 ),
			            "__ActiveAtPeil",   IF( [__EffStart] <= Peildatum  && [__EffEnd] >= Peildatum,  1, 0 )
			        ),
			        [__ActiveAtStart], DESC,
			        [__ActiveAtPeil],  DESC,
			        [__EffStart],      DESC,
			        employees_enriched[CardId], DESC
			    )
			
			VAR CardIdViaNaam = MAXX( BestRow, employees_enriched[CardId] )
			
			RETURN
			    IF( NOT ISBLANK( EigenCardId ), EigenCardId, CardIdViaNaam )
			
			```
		formatString: 0
		lineageTag: 510f446a-9b07-41f0-b397-8316e4524ba5

