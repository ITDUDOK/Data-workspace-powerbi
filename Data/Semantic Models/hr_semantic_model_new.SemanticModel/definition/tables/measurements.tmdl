	measure Gewerkte_Uren_MA =
			
			VAR HuidigCardID = [CardID_MA_Gekozen_OpNaam]
			
			VAR SelectedYear =
			    COALESCE(
			        SELECTEDVALUE(dates[Year]),
			        YEAR(TODAY())
			    )
			
			VAR SelectedMonth =
			    COALESCE(
			        SELECTEDVALUE(dates[Month]),
			        MONTH(TODAY())
			    )
			
			VAR VorigeMaandDate =
			    EDATE(
			        DATE(SelectedYear, SelectedMonth, 1),
			        -1
			    )
			
			VAR VorigeStartDatum =
			    DATE(
			        YEAR(VorigeMaandDate),
			        MONTH(VorigeMaandDate),
			        1
			    )
			
			VAR VorigeEindDatum =
			    EOMONTH(VorigeMaandDate, 0)
			
			VAR AantalEchteUrenRows =
			    CALCULATE(
			        COUNTROWS(hours),
			        FILTER(
			            ALL(hours),
			            hours[CardId] = HuidigCardID
			                && hours[HourDate] >= VorigeStartDatum
			                && hours[HourDate] <= VorigeEindDatum
			        )
			    )
			
			VAR EchteUren_FACT_Hours =
			    CALCULATE(
			        SUM(hours[HourHours]),
			        FILTER(
			            ALL(hours),
			            hours[CardId] = HuidigCardID
			                && hours[HourDate] >= VorigeStartDatum
			                && hours[HourDate] <= VorigeEindDatum
			        )
			    )
			
			VAR CalculatedUren_Summary =
			    CALCULATE(
			        SUM(hours_summary[HourHours]),
			        FILTER(
			            ALL(hours_summary),
			            hours_summary[CardId] = HuidigCardID
			                && hours_summary[HourDate] >= VorigeStartDatum
			                && hours_summary[HourDate] <= VorigeEindDatum
			                && (
			                    hours_summary[IsCalculatedHours] IN { "Yes", "YES", "Ja", "JA", "True", "TRUE", "1" }
			                    || hours_summary[HourTypeName] = "Calculated Contract Hours"
			                    || hours_summary[HourType] = 99
			                )
			        )
			    )
			
			RETURN
			    IF(
			        ISBLANK(HuidigCardID),
			        BLANK(),
			        IF(
			            AantalEchteUrenRows > 0,
			            COALESCE(EchteUren_FACT_Hours, 0),
			            COALESCE(CalculatedUren_Summary, 0)
			        )
			    )
		lineageTag: a0756fa0-a032-45cd-a59d-782302f61965

	measure Werklocatie_Filter_MA = ```
			
			VAR HuidigCardID = SELECTEDVALUE(employees_enriched[CardId])
			
			VAR SelectedYear  = IF(HASONEVALUE(dates[Year]),  VALUES(dates[Year]),  YEAR(TODAY()))
			VAR SelectedMonth = IF(HASONEVALUE(dates[Month]), VALUES(dates[Month]), MONTH(TODAY()))
			
			-- Geselecteerde werklocaties ophalen VOOR de REMOVEFILTERS -- anders weg
			VAR GeselOfficeNames = VALUES(slicer_werklocatie[OfficeName])
			VAR HeeftSelectie =
			    COUNTROWS(GeselOfficeNames) < COUNTROWS(ALL(slicer_werklocatie[OfficeName]))
			
			VAR UrenPerLocatie =
			    ADDCOLUMNS(
			        CALCULATETABLE(
			            VALUES(hours[HourOfficeId]),
			            REMOVEFILTERS(hours),
			            REMOVEFILTERS(dates),
			            hours[CardId] = HuidigCardID,
			            dates[Year]  = SelectedYear,
			            dates[Month] = SelectedMonth
			        ),
			        "TotaalUren", CALCULATE(
			            SUM(hours[HourHours]),
			            REMOVEFILTERS(hours),
			            REMOVEFILTERS(dates),
			            hours[CardId] = HuidigCardID,
			            dates[Year]  = SelectedYear,
			            dates[Month] = SelectedMonth
			        )
			    )
			
			VAR MaxUren     = MAXX(UrenPerLocatie, [TotaalUren])
			VAR TopOfficeID =
			    MAXX(FILTER(UrenPerLocatie, [TotaalUren] = MaxUren), hours[HourOfficeId])
			VAR TopOfficeName =
			    LOOKUPVALUE(offices[OfficeName], offices[OfficeId], TopOfficeID)
			
			VAR FallbackOfficeID = SELECTEDVALUE(employees_enriched[OfficeId])
			VAR FallbackName =
			    LOOKUPVALUE(offices[OfficeName], offices[OfficeId], FallbackOfficeID)
			
			VAR EffectiefName = IF(NOT ISBLANK(TopOfficeName), TopOfficeName, FallbackName)
			
			RETURN
			    IF(
			        ISBLANK(HuidigCardID),
			        BLANK(),
			        IF(
			            NOT HeeftSelectie,
			            1,
			            IF(CONTAINSROW(GeselOfficeNames, EffectiefName), 1, BLANK())
			        )
			    )
			
			```
		formatString: 0
		lineageTag: 65a2354e-f77b-4970-99c7-ce1cb7dcbf0a

