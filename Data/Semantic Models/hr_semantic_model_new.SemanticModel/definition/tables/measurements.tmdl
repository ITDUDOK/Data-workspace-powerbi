	measure FTE_Berekening_Actieve_Contracten = ```
			
			VAR GekozenData = VALUES(dates[Date])
			VAR HeeftSelectie = NOT ISEMPTY(GekozenData)
			VAR MinDate = IF(HeeftSelectie, MINX(GekozenData, dates[Date]), TODAY())
			VAR MaxDate = IF(HeeftSelectie, MAXX(GekozenData, dates[Date]), TODAY())
			
			RETURN
			CALCULATE(
			    SUMX(
			        VALUES(hr_contracts[EmployeeId]),
			        VAR CurrentEmployee = hr_contracts[EmployeeId]
			        VAR ActiveContractHours = 
			            CALCULATE(
			                MAX(hr_contracts[HoursPerWeek]),
			                hr_contracts[EmployeeId] = CurrentEmployee,
			                -- Use the same active contract logic as the employee count
			                hr_contracts[StartDate] <= MaxDate,
			                (
			                    hr_contracts[Indefinite] = TRUE() ||
			                    ISBLANK(hr_contracts[EndDate]) ||
			                    hr_contracts[EndDate] >= MinDate
			                )
			            )
			        
			        RETURN
			        IF(
			            ISBLANK(ActiveContractHours),
			            0, -- No active contract
			            DIVIDE(ActiveContractHours, 38, 0)
			        )
			    ),
			    REMOVEFILTERS(dates),  -- Remove date filters like in the working measure
			    KEEPFILTERS(
			        FILTER(
			            ALL(hr_contracts),
			            -- Only include contracts that are active during the selected period
			            hr_contracts[StartDate] <= MaxDate
			            &&
			            (
			                hr_contracts[Indefinite] = TRUE() ||
			                ISBLANK(hr_contracts[EndDate]) ||
			                hr_contracts[EndDate] >= MinDate
			            )
			        )
			    )
			)
			```
		lineageTag: de9404d4-a468-4502-af9e-eeb513cc96d4

	measure Functie_Latest = ```
			
			VAR CurrentEmployeeId = SELECTEDVALUE(employees_enriched[EmployeeId])
			RETURN
			IF(
			    ISBLANK(CurrentEmployeeId),
			    BLANK(),
			    
			    VAR LatestFunctionRecord = 
			        TOPN(
			            1,
			            FILTER(
			                hr_functions,
			                hr_functions[EmployeeId] = CurrentEmployeeId
			            ),
			            hr_functions[CreatedAt],
			            DESC
			        )
			    
			    RETURN
			    MAXX(
			        LatestFunctionRecord,
			        hr_functions[FunctionDescription]
			    )
			)
			```
		lineageTag: 8e246f8d-952b-4bb4-8377-45a967b8420a

	measure 'Manager Concat' = ```
			
			VAR CurrentEmployeeId = SELECTEDVALUE(employees_enriched[EmployeeId])
			RETURN
			IF(
			    ISBLANK(CurrentEmployeeId),
			    BLANK(),
			    VAR LatestManager = 
			        TOPN(
			            1,
			            FILTER(
			                employee_managers,
			                employee_managers[EmployeeId] = CurrentEmployeeId &&
			                NOT(ISBLANK(employee_managers[ManagerFirstName]))
			            ),
			            employee_managers[CreatedAt], DESC
			        )
			    RETURN
			        MAXX(
			            LatestManager,
			            employee_managers[ManagerFirstName] & " " & employee_managers[ManagerLastName]
			        )
			)
			```
		lineageTag: 69abacbd-d6e3-49cc-b81d-b092881f169a

	measure SicknessHourSom =
			
			VAR GekozenData = VALUES(dates[Date])
			VAR HeeftSelectie = NOT ISEMPTY(GekozenData)
			VAR MinDate = IF(HeeftSelectie, MINX(GekozenData, dates[Date]), TODAY())
			VAR MaxDate = IF(HeeftSelectie, MAXX(GekozenData, dates[Date]), TODAY())
			VAR CurrentCardIDs = VALUES(employees_enriched[CardId])
			
			RETURN
			CALCULATE(
			    SUMX(
			        sickness,
			        VAR SicknessStart = sickness[SicknessStart]
			        VAR SicknessEnd = IF(ISBLANK(sickness[SicknessEnd]), TODAY(), sickness[SicknessEnd])
			        VAR OverlapStart = MAX(SicknessStart, MinDate)
			        VAR OverlapEnd = MIN(SicknessEnd, MaxDate)
			
			        RETURN
			        IF(
			            OverlapStart <= OverlapEnd,
			            sickness[SicknessHours] *
			            DIVIDE(OverlapEnd - OverlapStart + 1, SicknessEnd - SicknessStart + 1, 0),
			            0
			        )
			    ),
			    REMOVEFILTERS(dates),
			    sickness[CardId] IN CurrentCardIDs
			)
		lineageTag: 93faa079-20b5-464a-bcfd-8db2fde2887c

	measure SicknessEntries =
			
			VAR GekozenData = VALUES(dates[Date])
			VAR HeeftSelectie = NOT ISEMPTY(GekozenData)
			VAR MinDate = IF(HeeftSelectie, MINX(GekozenData, dates[Date]), TODAY())
			VAR MaxDate = IF(HeeftSelectie, MAXX(GekozenData, dates[Date]), TODAY())
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(sickness[MeldingId]),
			    sickness[SicknessStart] <= MaxDate,
			    sickness[SicknessEnd] >= MinDate,
			    REMOVEFILTERS(dates)
			)
