	measure Contractlocatie_MA = ```
			
			VAR HuidigCardID = [CardID_MA_Gekozen_OpNaam]
			VAR OfficeID = 
			    CALCULATE(
			        SELECTEDVALUE( employees_enriched[OfficeID] ),
			        employees_enriched[CardId] = HuidigCardID
			    )
			VAR OfficeNaam =
			    LOOKUPVALUE(
			        offices[OfficeName],
			        offices[OfficeId],
			        OfficeID
			    )
			VAR LocatieViaUren =
			    LOOKUPVALUE(
			        offices[OfficeName],
			        offices[OfficeId],
			        CALCULATE(
			            MAX(hours[OfficeId]),
			            hours[CardId] = HuidigCardID
			        )
			    )
			RETURN
			    IF(
			        NOT ISBLANK(HuidigCardID),
			        IF(
			            NOT ISBLANK(OfficeNaam),
			            OfficeNaam,
