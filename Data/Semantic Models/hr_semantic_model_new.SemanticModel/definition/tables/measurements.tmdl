	measure Gewerkte_Uren_Per_Medewerker_HR =
			
			VAR CurrentCardID = SELECTEDVALUE(staff[CardId])
			VAR GekozenData = VALUES(dates[Date])
			VAR HeeftSelectie = NOT ISEMPTY(GekozenData)
			VAR MinDate = IF(HeeftSelectie, MINX(GekozenData, dates[Date]), TODAY())
			VAR MaxDate = IF(HeeftSelectie, MAXX(GekozenData, dates[Date]), TODAY())
			
			RETURN
			IF(
			    NOT ISBLANK(CurrentCardID),
			    CALCULATE(
			        SUM(hours[HourHours]),
			        REMOVEFILTERS(dates),
			        KEEPFILTERS(
			            FILTER(
			                ALL(hours),
			                hours[CardId] = CurrentCardID &&
			                hours[HourDate] >= MinDate &&
			                hours[HourDate] <= MaxDate
			            )
			        )
			    ),
			    BLANK()
			)
		lineageTag: 2de0a0ea-fb8e-4ad2-b9d3-a74861318630

	measure AantalNieuweWerknemers =
			
			VAR GekozenData = VALUES(dates[Date])
			VAR HeeftSelectie = NOT ISEMPTY(GekozenData)
			VAR MinDate = IF(HeeftSelectie, MINX(GekozenData, dates[Date]), TODAY())
			VAR MaxDate = IF(HeeftSelectie, MAXX(GekozenData, dates[Date]), TODAY())
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(hr_contracts[EmployeeId]),
			    REMOVEFILTERS(dates),  -- Remove date filters
			    KEEPFILTERS(
			        FILTER(
			            ALL(hr_contracts),
			            -- Employee started during the selected period
			            hr_contracts[StartDate] >= MinDate
			            &&
			            hr_contracts[StartDate] <= MaxDate
			        )
			    )
			)
