	measure 'VK Loonkosten Gewicht' =
			VAR MinDate = MIN(dates[Date])
			VAR MaxDate = MAX(dates[Date])
			VAR CurrentOffices = VALUES(offices[OfficeId])
			VAR SourceOffices =
			    CALCULATETABLE(
			        VALUES(map_vkoffice[SourceOfficeId]),
			        TREATAS(CurrentOffices, map_vkoffice[TargetOfficeId])
			    )
			RETURN
			IF(
			    ISBLANK(MinDate),
			    BLANK(),
			    CALCULATE(
			        SUMX(
			            employees_enriched,
			            VAR WeeklyHours = employees_enriched[ContractHours]
			            VAR HourlyRate = employees_enriched[HourlySalary]
			            VAR EmpStart = employees_enriched[EmployeeStartDate]
			            VAR EmpEnd   = COALESCE(employees_enriched[EmployeeEndDate], MaxDate)
			            VAR OverlapStart = MAX(EmpStart, MinDate)
			            VAR OverlapEnd   = MIN(EmpEnd,   MaxDate)
			            VAR OverlapDays  =
			                IF(
			                    NOT ISBLANK(EmpStart) && OverlapStart <= OverlapEnd,
			                    OverlapEnd - OverlapStart + 1,
			                    0
			                )
			            RETURN COALESCE(WeeklyHours, 0) * DIVIDE(OverlapDays, 7, 0) * COALESCE(HourlyRate, 0)
			        ),
			        TREATAS(SourceOffices, employees_enriched[OfficeId]),
			        REMOVEFILTERS(offices)
			    )
			)
		isHidden
		lineageTag: d91c1cf1-39d4-4cf2-8633-0c4855716a9d

	measure 'VK Ziekte Gewicht' =
			VAR MinDate = MIN(dates[Date])
			VAR MaxDate = MAX(dates[Date])
			VAR CurrentOffices = VALUES(offices[OfficeId])
			VAR SourceOffices =
			    CALCULATETABLE(
			        VALUES(map_vkoffice[SourceOfficeId]),
			        TREATAS(CurrentOffices, map_vkoffice[TargetOfficeId])
			    )
			VAR RelevantCardIDs =
			    CALCULATETABLE(
			        VALUES(employees_enriched[CardId]),
			        TREATAS(SourceOffices, employees_enriched[OfficeId]),
			        REMOVEFILTERS(offices)
			    )
			RETURN
			IF(
			    ISBLANK(MinDate),
			    BLANK(),
			    CALCULATE(
			        SUMX(
			            FILTER(
			                sickness,
			                sickness[CardId] IN RelevantCardIDs
			                    && NOT ISBLANK(sickness[SicknessEnd])
			                    && sickness[SicknessEnd] >= MinDate
			                    && sickness[SicknessEnd] <= MaxDate
			            ),
			            VAR CurrentCard = sickness[CardId]
			            VAR Rate =
			                CALCULATE(
			                    MAX(employees_enriched[HourlySalary]),
			                    ALL(employees_enriched),
			                    employees_enriched[CardId] = CurrentCard
			                )
			            RETURN sickness[SicknessHours] * COALESCE(Rate, 0)
			        ),
			        REMOVEFILTERS(dates),
			        REMOVEFILTERS(offices)
			    )
			)
		isHidden
		lineageTag: ee140865-ae90-4e95-8e20-f916cacfdd7b

	measure Leeftijd_MA = ```
			
			VAR HuidigCardID = [CardID_MA_Gekozen_OpNaam]
			RETURN
			    IF(
			        ISBLANK( HuidigCardID ),
			        BLANK(),
			        VAR GeboorteDatum =
			            CALCULATE(
			                SELECTEDVALUE( employees_enriched[DateOfBirth] ),
			                employees_enriched[CardId] = HuidigCardID
			            )
			        RETURN
			            IF(
			                ISBLANK( GeboorteDatum ),
			                BLANK(),
			                DATEDIFF( GeboorteDatum, TODAY(), YEAR )
			            )
			    )
			
			```
		formatString: 0
		lineageTag: 0a6daecc-602e-47c9-92f6-9616f2867131

