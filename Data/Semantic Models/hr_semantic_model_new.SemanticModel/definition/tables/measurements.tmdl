	measure FTE =
			
			VAR GekozenDatum = SELECTEDVALUE(dates[Date])
			VAR GekozenMaand = SELECTEDVALUE(dates[Month])
			VAR GekozenWeek = SELECTEDVALUE(dates[WeekISO])  -- Adjust column name if needed
			VAR GekozenJaar = SELECTEDVALUE(dates[YearISO])
			
			VAR BeginPeriode =
			    IF(
			        NOT ISBLANK(GekozenDatum),
			        GekozenDatum,
			        IF(
			            NOT ISBLANK(GekozenMaand) && NOT ISBLANK(GekozenJaar),
			            CALCULATE(
			                MIN(dates[Date]),
			                dates[Month] = GekozenMaand,
			                dates[YearISO] = GekozenJaar
			            ),
			            IF(
			                NOT ISBLANK(GekozenWeek) && NOT ISBLANK(GekozenJaar),
			                CALCULATE(
			                    MIN(dates[Date]),
			                    dates[WeekISO] = GekozenWeek,
			                    dates[YearISO] = GekozenJaar
			                ),
			                DATE(GekozenJaar, 1, 1)
			            )
			        )
			    )
			
			VAR EindPeriode =
			    IF(
			        NOT ISBLANK(GekozenDatum),
			        GekozenDatum,
			        IF(
			            NOT ISBLANK(GekozenMaand) && NOT ISBLANK(GekozenJaar),
			            CALCULATE(
			                MAX(dates[Date]),
			                dates[Month] = GekozenMaand,
			                dates[YearISO] = GekozenJaar
			            ),
			            IF(
			                NOT ISBLANK(GekozenWeek) && NOT ISBLANK(GekozenJaar),
			                CALCULATE(
			                    MAX(dates[Date]),
			                    dates[WeekISO] = GekozenWeek,
			                    dates[YearISO] = GekozenJaar
			                ),
			                DATE(GekozenJaar, 12, 31)
			            )
			        )
			    )
			
			RETURN
			IF(
			    NOT ISBLANK(BeginPeriode),
			    CALCULATE(
			        SUMX(
			            FILTER(
			                ADDCOLUMNS(
			                    VALUES(staff[CardId]),
			                    "CardEnd", CALCULATE(MAX(staff[CardEnd])),
			                    "CardStart", CALCULATE(MAX(staff[CardStart])),
			                    "CardDateOfBirth", CALCULATE(MAX(staff[CardDateOfBirth]))
			                ),
			                [CardStart] <= EindPeriode &&
			                (ISBLANK([CardEnd]) || [CardEnd] >= BeginPeriode) &&
			                NOT ISBLANK([CardDateOfBirth])
			            ),
			            VAR CardID = staff[CardId]
			
			            VAR Profiel =
			                CALCULATE(
			                    MAX(contracts[Profile]),
			                    FILTER(contracts, contracts[CardId] = CardID)
			                )
			
			            VAR ContractUren =
			                CALCULATE(
			                    MAX(contracts[ContractWeekHours]),
			                    FILTER(contracts, contracts[CardId] = CardID)
			                )
			
			            VAR UrenGewerkt =
			                CALCULATE(
			                    SUM(hours[HourHours]),
			                    FILTER(hours, hours[CardId] = CardID)
			                )
			
			            VAR UniekeWeken =
			                DISTINCT(
			                    SELECTCOLUMNS(
			                        FILTER(hours, hours[CardId] = CardID),
			                        "Week", WEEKNUM(hours[HourDate], 2) & "-" & YEAR(hours[HourDate])
			                    )
			                )
			
			            VAR AantalWeken = COUNTROWS(UniekeWeken)
			            VAR GemiddeldeUren = DIVIDE(UrenGewerkt, AantalWeken, 0)
			
			            RETURN
			                SWITCH(
			                    TRUE(),
			                    Profiel = "Medewerker met vaste uren" || Profiel = "All in Medewerker met vaste uren", DIVIDE(ContractUren, 38, 0),
			                    Profiel = "Medewerker zonder vaste uren", DIVIDE(GemiddeldeUren, 38, 0),
			                    0
			                )
			        ),
			        ALL(dates)
			    ),
			    BLANK()
			)
		lineageTag: 119671da-13a1-4585-9baf-b011bc3b42f6

	measure Average_salary =
			
