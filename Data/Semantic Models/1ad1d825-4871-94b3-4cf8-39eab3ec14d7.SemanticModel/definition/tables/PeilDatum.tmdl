table PeilDatum
	lineageTag: a6ed0439-0657-4a73-8f45-c92b70ec5c78

	column Date
		isNameInferred
		sourceColumn: [Date]

	column Jaar
		isNameInferred
		sourceColumn: [Jaar]

	column Maand
		isNameInferred
		sourceColumn: [Maand]

	column MaandNaam
		isNameInferred
		sourceColumn: [MaandNaam]

	column WeekNr
		isNameInferred
		sourceColumn: [WeekNr]

	column JaarMaand
		isNameInferred
		sourceColumn: [JaarMaand]

	column JaarWeek
		isNameInferred
		sourceColumn: [JaarWeek]

	partition PeilDatum = calculated
		mode: import
		source =
				
				VAR Basis = CALENDAR(DATE(2020,1,1), TODAY())
				RETURN
				SELECTCOLUMNS(
				    ADDCOLUMNS(
				        Basis,
				        "@Jaar", YEAR([Date]),
				        "@Maand", MONTH([Date]),
				        "@MaandNaam", FORMAT([Date], "MMMM", "en-US"),
				        "@WeekNr", WEEKNUM([Date], 1),
				        "@JaarMaand", FORMAT([Date], "YYYY-MM"),
				        "@JaarWeek", FORMAT(YEAR([Date]), "0") & "-W" & RIGHT("0" & FORMAT(WEEKNUM([Date], 1), "0"), 2)
				    ),
				    "Date", [Date],
				    "Jaar", [@Jaar],
				    "Maand", [@Maand],
				    "MaandNaam", [@MaandNaam],
				    "WeekNr", [@WeekNr],
				    "JaarMaand", [@JaarMaand],
				    "JaarWeek", [@JaarWeek]
				)

