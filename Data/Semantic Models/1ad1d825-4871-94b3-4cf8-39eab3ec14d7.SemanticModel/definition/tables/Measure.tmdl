	measure 'Prognose Deze Week' =
			
			VAR refKeuze     = SELECTEDVALUE( referentieperiode[ReferentieID], 2 )
			VAR correctie    = DIVIDE( [Correctie %], 100, 0 )
			VAR huidigItem   = SELECTEDVALUE( StockOverview[Item] )
			VAR selWeekStart = MIN( dates[Date] )
			VAR selWeekEind  = MAX( dates[Date] )
			
			// OPTIE 1: Vorig jaar ±2 weken (5 weken totaal)
			VAR anker   = selWeekStart - 364
			VAR start5w = anker - 14
			VAR eind5w  = anker + 14 + ( selWeekEind - selWeekStart )
			VAR verkoop5w =
			    CALCULATE(
			        -SUM( StockTransactions[Quantity] ),
			        REMOVEFILTERS( StockTransactions ),
			        REMOVEFILTERS( dates ),
			        StockTransactions[Item] = huidigItem,
			        StockTransactions[Status] = 21,
			        StockTransactions[Type] IN {120, 122},
			        dates[Date] >= start5w,
			        dates[Date] <= eind5w
			    )
			VAR gem5w = DIVIDE( verkoop5w, 5 )
			
			// OPTIE 2: Gemiddelde laatste 4 weken
			VAR start4w = selWeekStart - 28
			VAR eind4w  = selWeekStart - 1
			VAR verkoop4w =
			    CALCULATE(
			        -SUM( StockTransactions[Quantity] ),
			        REMOVEFILTERS( StockTransactions ),
			        REMOVEFILTERS( dates ),
			        StockTransactions[Item] = huidigItem,
			        StockTransactions[Status] = 21,
			        StockTransactions[Type] IN {120, 122},
			        dates[Date] >= start4w,
			        dates[Date] <= eind4w
			    )
			VAR gem4w = DIVIDE( verkoop4w, 4 )
			
			// OPTIE 3: Gemiddelde laatste 10 weken
			VAR start10w = selWeekStart - 70
			VAR eind10w  = selWeekStart - 1
			VAR verkoop10w =
			    CALCULATE(
			        -SUM( StockTransactions[Quantity] ),
			        REMOVEFILTERS( StockTransactions ),
			        REMOVEFILTERS( dates ),
			        StockTransactions[Item] = huidigItem,
			        StockTransactions[Status] = 21,
			        StockTransactions[Type] IN {120, 122},
			        dates[Date] >= start10w,
			        dates[Date] <= eind10w
			    )
			VAR gem10w = DIVIDE( verkoop10w, 10 )
			
			VAR basis =
			    SWITCH(
			        refKeuze,
			        1, gem5w,
			        2, gem4w,
			        3, gem10w,
			        gem4w  // fallback naar 4 weken ipv BLANK
			    )
			
			RETURN
			    ROUND( basis * ( 1 + correctie ), 0 )
		lineageTag: 14b6cd8c-c900-4138-8c73-78981c412c10

	measure 'Weken Voorraad' =
			
			VAR prognose = [Prognose Deze Week]
			VAR voorraad = [Stock At Date]
			RETURN
			    IF( prognose > 0, ROUND( DIVIDE( voorraad, prognose ), 1 ), BLANK() )
		lineageTag: 4a5d6e69-8a36-41f2-bd21-60859ab1726a

	measure Tekort =
			
			VAR prognose = [Prognose Deze Week]
			VAR voorraad = [MRP Actuele Voorraad]
			RETURN
			    IF( voorraad < prognose, prognose - voorraad, 0 )
		lineageTag: 542a1f17-1453-4cbd-92d2-6326ac045ef5

	measure 'Debug Prognose' = ```
			
			VAR huidigItem      = SELECTEDVALUE( StockOverview[Item] )
			VAR huidigWarehouse = SELECTEDVALUE( StockOverview[Warehouse] )
			VAR selWeekStart    = MIN( dates[Date] )
			
			RETURN
			    "Start=" & FORMAT(selWeekStart, "DD-MM-YYYY")
			    & " | 4w=" & FORMAT(selWeekStart - 28, "DD-MM-YYYY")
			    & " | Item=" & LEFT(huidigItem, 8)
			    & " | Qty=" & 
			    CALCULATE(
			        ABS( SUM( StockTransactions[Quantity] ) ),
			        REMOVEFILTERS( StockTransactions ),
			        StockTransactions[Item] = huidigItem,
			        StockTransactions[Warehouse] = huidigWarehouse,
			        StockTransactions[Type] IN {120, 122, 124, 125, 131, 133, 141, 148, 150, 155, 161, 165, 196},
			        StockTransactions[Status] = 21,
			        StockTransactions[TransactionDate] >= selWeekStart - 28,
			        StockTransactions[TransactionDate] <= selWeekStart - 1
			    )
			```
		lineageTag: ed2c5ea5-6316-419f-b2d8-2679fbda55fa

