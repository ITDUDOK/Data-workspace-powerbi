	measure 'Behoefte Voorraadprognose' =
			
			
			VAR huidigItem = COALESCE(
			    SELECTEDVALUE( StockOverview[Item] ),
			    SELECTEDVALUE( Items[ItemID] )
			)
			
			VAR verwachteVoorraad =
			    CALCULATE(
			        [Stock At Date] - [Prognose Deze Week] + [Productie Deze Week],
			        TREATAS( { huidigItem }, StockOverview[Item] )
			    )
			
			RETURN
			    IF( verwachteVoorraad < 0, verwachteVoorraad, BLANK() )
		lineageTag: 5241ab0a-ecda-4989-a6c3-b391dd6f1ab1

	measure 'Inkoopprognose verwachte Voorraadprognose' =
			
			
			VAR verwacht      = [Inkoop Prognose Deze Week]
			VAR mrpPrognose   = [MRP Prognose Deze Week]
			VAR actueel       = [MRP Actuele Voorraad]
			VAR besteld       = [MRP Bestelling Deze Week]
			VAR nettobehoefte = actueel + besteld - verwacht - mrpPrognose
			
			RETURN
			    nettobehoefte
