	measure 'Verkopen 3 Weken Terug' = ```
			
			// Daadwerkelijke verkopen in week -3, geanker aan TODAY().
			// Bron: StockTransactions Type 120/122 (verkoop + verkoop-retour),
			// status 21 (geboekt). Negatie omdat uitgaande mutaties negatief zijn.
			VAR Vandaag    = TODAY()
			VAR WeekStart  = Vandaag - WEEKDAY( Vandaag, 2 ) + 1 - 21
			VAR WeekEind   = WeekStart + 6
			VAR HuidigItem = SELECTEDVALUE( StockOverview[Item] )
			RETURN
			CALCULATE(
			    -SUM( StockTransactions[Quantity] ),
			    REMOVEFILTERS( StockTransactions ),
			    REMOVEFILTERS( dates ),
			    StockTransactions[Item]   = HuidigItem,
			    StockTransactions[Status] = 21,
			    StockTransactions[Type]   IN { 120, 122 },
			    dates[Date] >= WeekStart,
			    dates[Date] <= WeekEind
			)
			
			```
		formatString: #,0
		lineageTag: 5be909bc-6b4f-4754-9a00-9b1905f45bd7

	measure 'Orders Deze Week (Open)' = ```
			
			// Openstaande verkooporders met afleverdatum in de huidige (kalender)week.
			// Geanker aan TODAY(); negeert PeilDatum-slicer.
			// Patroon: gelijk aan 'Openstaande Verkoop Aantal', met datumvenster.
			VAR Vandaag   = TODAY()
			VAR WeekStart = Vandaag - WEEKDAY( Vandaag, 2 ) + 1
			VAR WeekEind  = WeekStart + 6
			RETURN
			CALCULATE(
			    ABS( SUM( StockPlanning[OrderQuantity] ) ),
			    REMOVEFILTERS( StockPlanning ),
			    StockPlanning[Item]      IN VALUES( StockOverview[Item] ),
			    StockPlanning[Warehouse] IN VALUES( StockOverview[Warehouse] ),
			    StockPlanning[Type]      = 120,
			    StockPlanning[Status]    = 12,
			    StockPlanning[IsPending] = 1,
			    StockPlanning[DueDate]  >= WeekStart,
			    StockPlanning[DueDate]  <= WeekEind
			)
			
			```
		formatString: #,0
		lineageTag: 49365962-5fc7-410d-b2f8-faa014e62b7e

	measure 'Prognose Choco Deze Week' = ```
			
			// Identieke berekening als [Prognose Deze Week] uit Voorraadprognose,
			// maar geanker aan de huidige kalenderweek (TODAY()) i.p.v. dates-context.
			// Zo werkt de Chocolade-pagina zonder week-slicer.
			
			VAR Vandaag      = TODAY()
			VAR selWeekStart = Vandaag - WEEKDAY( Vandaag, 2 ) + 1
			VAR selWeekEind  = selWeekStart + 6
			VAR refKeuze     = SELECTEDVALUE( referentieperiode[ReferentieID], 2 )
			VAR correctie    = DIVIDE( [Correctie %], 100, 0 )
			VAR huidigItem   = SELECTEDVALUE( StockOverview[Item] )
			
			// OPTIE 1: Vorig jaar +/- 2 weken (5 weken totaal)
			VAR anker   = selWeekStart - 364
			VAR start5w = anker - 14
			VAR eind5w  = anker + 14 + ( selWeekEind - selWeekStart )
			VAR verkoop5w =
			    CALCULATE(
			        -SUM( StockTransactions[Quantity] ),
			        REMOVEFILTERS( StockTransactions ),
			        REMOVEFILTERS( dates ),
			        StockTransactions[Item]   = huidigItem,
			        StockTransactions[Status] = 21,
			        StockTransactions[Type]   IN { 120, 122 },
			        dates[Date] >= start5w,
			        dates[Date] <= eind5w
			    )
			VAR gem5w = DIVIDE( verkoop5w, 5 )
			
			// OPTIE 2: Gemiddelde laatste 4 weken
			VAR start4w = selWeekStart - 28
			VAR eind4w  = selWeekStart - 1
			VAR verkoop4w =
			    CALCULATE(
			        -SUM( StockTransactions[Quantity] ),
			        REMOVEFILTERS( StockTransactions ),
			        REMOVEFILTERS( dates ),
			        StockTransactions[Item]   = huidigItem,
			        StockTransactions[Status] = 21,
			        StockTransactions[Type]   IN { 120, 122 },
			        dates[Date] >= start4w,
			        dates[Date] <= eind4w
			    )
			VAR gem4w = DIVIDE( verkoop4w, 4 )
			
			// OPTIE 3: Gemiddelde laatste 10 weken
			VAR start10w = selWeekStart - 70
			VAR eind10w  = selWeekStart - 1
			VAR verkoop10w =
			    CALCULATE(
			        -SUM( StockTransactions[Quantity] ),
			        REMOVEFILTERS( StockTransactions ),
			        REMOVEFILTERS( dates ),
			        StockTransactions[Item]   = huidigItem,
			        StockTransactions[Status] = 21,
			        StockTransactions[Type]   IN { 120, 122 },
			        dates[Date] >= start10w,
			        dates[Date] <= eind10w
			    )
			VAR gem10w = DIVIDE( verkoop10w, 10 )
			
			VAR basis =
			    SWITCH(
			        refKeuze,
			        1, gem5w,
			        2, gem4w,
			        3, gem10w,
			        gem4w
			    )
			
			RETURN
			    ROUND( basis * ( 1 + correctie ), 0 )
			
			```
		lineageTag: df6a9edc-aad2-49f6-8091-af20f9360ba4

	measure 'Prognose Choco Volgende Week' = ```
			
			// Identieke berekening als [Prognose Volgende Week] uit Voorraadprognose,
			// maar geanker aan TODAY()'s eerstvolgende kalenderweek.
			
			VAR Vandaag      = TODAY()
			VAR selWeekStart = Vandaag - WEEKDAY( Vandaag, 2 ) + 1 + 7
			VAR selWeekEind  = selWeekStart + 6
			VAR refKeuze     = SELECTEDVALUE( referentieperiode[ReferentieID], 2 )
			VAR correctie    = DIVIDE( [Correctie %], 100, 0 )
			VAR huidigItem   = SELECTEDVALUE( StockOverview[Item] )
			
			// OPTIE 1: Vorig jaar zelfde week
			VAR vjStart = selWeekStart - 364
			VAR vjEind  = selWeekEind  - 364
			VAR verkoopVorigJaar =
			    CALCULATE(
			        -SUM( StockTransactions[Quantity] ),
			        REMOVEFILTERS( StockTransactions ),
			        REMOVEFILTERS( dates ),
			        StockTransactions[Item]   = huidigItem,
			        StockTransactions[Status] = 21,
			        StockTransactions[Type]   IN { 120, 122 },
			        dates[Date] >= vjStart,
			        dates[Date] <= vjEind
			    )
			
			// OPTIE 2: Laatste 4 weken
			VAR start4w = selWeekStart - 28
			VAR eind4w  = selWeekStart - 1
			VAR verkoop4w =
			    CALCULATE(
			        -SUM( StockTransactions[Quantity] ),
			        REMOVEFILTERS( StockTransactions ),
			        REMOVEFILTERS( dates ),
			        StockTransactions[Item]   = huidigItem,
			        StockTransactions[Status] = 21,
			        StockTransactions[Type]   IN { 120, 122 },
			        dates[Date] >= start4w,
			        dates[Date] <= eind4w
			    )
			VAR gem4w = DIVIDE( verkoop4w, 4 )
			
			// OPTIE 3: Laatste 10 weken
			VAR start10w = selWeekStart - 70
			VAR eind10w  = selWeekStart - 1
			VAR verkoop10w =
			    CALCULATE(
			        -SUM( StockTransactions[Quantity] ),
			        REMOVEFILTERS( StockTransactions ),
			        REMOVEFILTERS( dates ),
			        StockTransactions[Item]   = huidigItem,
			        StockTransactions[Status] = 21,
			        StockTransactions[Type]   IN { 120, 122 },
			        dates[Date] >= start10w,
			        dates[Date] <= eind10w
			    )
			VAR gem10w = DIVIDE( verkoop10w, 10 )
			
			VAR basis =
			    SWITCH(
			        refKeuze,
			        1, verkoopVorigJaar,
			        2, gem4w,
			        3, gem10w,
			        gem4w
			    )
			
			RETURN
			    ROUND( basis * ( 1 + correctie ), 0 )
			
			```
		formatString: #,0
		lineageTag: 56b7aa3b-a1ac-40ed-b26d-eb9ee72168de

	measure 'Prognose Choco Deze Week min Orders' = ```
			
			// Resterende prognose voor deze week, na aftrek van reeds openstaande orders.
			// Bodem op 0: nooit negatief tonen.
			VAR Resterend = [Prognose Choco Deze Week] - [Orders Deze Week (Open)]
			RETURN
			    IF( Resterend < 0, 0, Resterend )
			
			```
		formatString: #,0
		lineageTag: 39414539-cf72-4c31-b125-2658e64f5c41

	measure 'Uitsluiten 0 voorraad Peildatum' = ```
			
			// Variant van [Uitsluiten 0 voorraad] voor pagina's waar de datum-slicer
			// op PeilDatum staat (i.p.v. StockDateTable). Gebruikt [Stock op Peildatum]
			// dat default TODAY() teruggeeft als er niets geselecteerd is.
			VAR keuze = SELECTEDVALUE( voorraadfilter[Waarde], 0 )
			RETURN
			    IF( keuze = 0, 1, IF( [Stock op Peildatum] > 0, 1, 0 ) )
			
			```
		lineageTag: 44b00027-e0c0-405b-8240-3ddaa25b4994

