	measure ExactOnlineURL =
			
			IF(
			    ISINSCOPE(Items[ItemNameCode]),
			    VAR WONummer = MAX(ShopOrders[ShopOrderNumber])
			    VAR WO_ID =
			        MAXX(
			            FILTER(ALL(ShopOrders), ShopOrders[ShopOrderNumber] = WONummer),
			            ShopOrders[ID]
			        )
			    VAR WO_Division =
			        MAXX(
			            FILTER(ALL(ShopOrders), ShopOrders[ShopOrderNumber] = WONummer),
			            ShopOrders[Division]
			        )
			    RETURN
			        "https://start.exactonline.nl/docs/MfgShopOrderCard.aspx?ID="
			            & "%7b" & UPPER(WO_ID) & "%7d"
			            & "&_Division_="
			            & FORMAT(WO_Division, "0"),
			    BLANK()
			)
		lineageTag: c1366724-14c4-4a08-a513-79f1495119da

