	measure 'Stock At Date' =
			
			VAR SelectedDate = MAX( PeilDatum[Date] )
			VAR ValidTypes = {
			    120, 121, 122, 123, 124, 125, 130, 131, 132, 133, 134, 135,
			    140, 141, 147, 148, 150, 151, 155, 156, 160, 161, 165, 166,
			    196, 197
			}
			VAR HuidigeStock =
			    CALCULATE(
			        SUM( StockPositions[Stock] ),
			        StockPositions[Item]      IN VALUES( StockOverview[Item] ),
			        StockPositions[Warehouse] IN VALUES( StockOverview[Warehouse] )
			    )
			VAR MutatiesNaDatum =
			    CALCULATE(
			        SUM( StockTransactions[Quantity] ),
			        REMOVEFILTERS( StockTransactions ),
			        REMOVEFILTERS( dates ),
			        StockTransactions[Item]            IN VALUES( StockOverview[Item] ),
			        StockTransactions[Warehouse]       IN VALUES( StockOverview[Warehouse] ),
			        StockTransactions[Status]          = 21,
			        StockTransactions[Type]            IN ValidTypes,
			        StockTransactions[TransactionDate] > SelectedDate
			    )
			RETURN
			    IF( NOT ISBLANK( SelectedDate ), HuidigeStock - MutatiesNaDatum, BLANK() )
		formatString: #,0
		lineageTag: 2021bc0b-81a9-4ffd-b69d-47f02db30f9b

	measure 'Stock Value At Date' = ```
			
			VAR SelectedDate = MAX(PeilDatum[Date])
			VAR Today = TODAY()
			
			RETURN
			IF(
			    NOT ISBLANK(SelectedDate),
			    SUMX(
			        StockOverview,
			        VAR ThisItem = StockOverview[Item]
			        VAR ThisWarehouse = StockOverview[Warehouse]
			        VAR CurrentStock = [Stock op Peildatum]
			        
			        // Bewegingen NA de geselecteerde datum
			        VAR MovementsAfterDate = 
			            CALCULATE(
			                SUM('StockTransactions'[Quantity]),
			                REMOVEFILTERS( 'StockTransactions' ),
			        'StockTransactions'[Item] = ThisItem,
			        'StockTransactions'[Warehouse] = ThisWarehouse,
			        'StockTransactions'[TransactionDate] > SelectedDate,
			        'StockTransactions'[TransactionDate] <= Today,
			        'StockTransactions'[Status] = 21
			            )
			        
			        // Voorraad op datum
			        VAR StockOnDate = CurrentStock - MovementsAfterDate
			        
			        // Laatste transactie datum TOT geselecteerde datum
			        VAR LastTxDate = 
			            CALCULATE(
			                MAX('StockTransactions'[TransactionDate]),
			                REMOVEFILTERS( 'StockTransactions' ),
			        'StockTransactions'[Item] = ThisItem,
			        'StockTransactions'[Warehouse] = ThisWarehouse,
			        'StockTransactions'[TransactionDate] <= SelectedDate,
			        'StockTransactions'[Status] = 21,
			        'StockTransactions'[CostPrice] <> 0
			            )
			        
			        // Laatste kostprijs op die datum
			        VAR LastCostPrice = 
			            CALCULATE(
			                SELECTEDVALUE('StockTransactions'[CostPrice]),
			                REMOVEFILTERS( 'StockTransactions' ),
			        'StockTransactions'[Item] = ThisItem,
			        'StockTransactions'[Warehouse] = ThisWarehouse,
			        'StockTransactions'[TransactionDate] = LastTxDate,
			        'StockTransactions'[Status] = 21,
			        'StockTransactions'[CostPrice] <> 0
			            )
			        
			        RETURN StockOnDate * LastCostPrice
			    ),
			    BLANK()
			)
			```
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		lineageTag: e14cd645-c8ee-4e07-894e-8486a466ee1e

	measure 'MRP Actuele Voorraad' = ```
			
			VAR SelectedItem = MAX( Items[ItemID] )
			VAR SelectedDate = CALCULATE( MAX( dates[Date] ), ALL( MRPInkopen ) )
			VAR Today        = TODAY()
			VAR ValidTypes   = {
			    120, 121, 122, 123, 124, 125, 130, 131, 132, 133, 134, 135,
			    140, 141, 147, 148, 150, 151, 155, 156, 160, 161, 165, 166,
			    196, 197
			}
			VAR CurrentStock = 
			    CALCULATE(
			        SUM( StockPositions[Stock] ),
			        REMOVEFILTERS( StockPositions ),
			        StockPositions[Item] = SelectedItem
			    )
			RETURN
			    IF(
			        ISBLANK( SelectedDate ) || SelectedDate >= Today,
			        CurrentStock + 0,
			        VAR MovementsAfterDate = 
			            CALCULATE(
			                SUM( StockTransactions[Quantity] ),
			                REMOVEFILTERS( StockTransactions ),
			                REMOVEFILTERS( dates ),
			                StockTransactions[Item]            = SelectedItem,
			                StockTransactions[TransactionDate] > SelectedDate,
			                StockTransactions[TransactionDate] <= Today,
			                StockTransactions[Status]          = 21,
			                StockTransactions[Type]            IN ValidTypes
			            )
			        RETURN CurrentStock - MovementsAfterDate + 0
			    )
			```
		formatString: #,0
		lineageTag: eba861ef-5984-4b1f-832d-352e46a959f5

	measure 'Forecast Quantity' =
			
			VAR SelectedDate = MAX(dates[Date])
			VAR SelectedYear = YEAR(SelectedDate)
			VAR SelectedWeek = MAX(dates[WeekISO])
			
			RETURN
			IF(
			    NOT ISBLANK(SelectedDate),
			    SUMX(
			        StockOverview,
			        VAR ThisItem = StockOverview[Item]
			        RETURN
			        CALCULATE(
			            SUM('SalesForecastDetails'[Quantity]),
			            REMOVEFILTERS( 'SalesForecastDetails' ),
			        'SalesForecastDetails'[Item] = ThisItem,
			        'SalesForecastDetails'[Year] = SelectedYear,
			        'SalesForecastDetails'[Period] = SelectedWeek
			        )
			    ),
			    BLANK()
			)
		lineageTag: 43530b01-acc0-4be6-a470-ada29959f937

