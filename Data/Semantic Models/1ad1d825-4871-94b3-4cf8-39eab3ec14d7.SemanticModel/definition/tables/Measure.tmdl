	measure 'Verkopen Vorige Week' = ```
			
			// Daadwerkelijke verkopen in week -1, geanker aan TODAY().
			// Bron: StockTransactions Type 120/122 (verkoop + verkoop-retour),
			// status 21 (geboekt). Negatie omdat uitgaande mutaties negatief zijn.
			VAR Vandaag    = TODAY()
			VAR WeekStart  = Vandaag - WEEKDAY( Vandaag, 2 ) + 1 - 7
			VAR WeekEind   = WeekStart + 6
			VAR HuidigItem = SELECTEDVALUE( StockOverview[Item] )
			RETURN
			CALCULATE(
			    -SUM( StockTransactions[Quantity] ),
			    REMOVEFILTERS( StockTransactions ),
			    REMOVEFILTERS( dates ),
			    StockTransactions[Item]   = HuidigItem,
			    StockTransactions[Status] = 21,
			    StockTransactions[Type]   IN { 120, 122 },
			    dates[Date] >= WeekStart,
			    dates[Date] <= WeekEind
			)
			
			```
		formatString: #,0
		lineageTag: 69dae21d-fb2f-409e-9d70-973750398202

	measure 'Verkopen 2 Weken Terug' = ```
			
			// Daadwerkelijke verkopen in week -2, geanker aan TODAY().
			// Bron: StockTransactions Type 120/122 (verkoop + verkoop-retour),
			// status 21 (geboekt). Negatie omdat uitgaande mutaties negatief zijn.
			VAR Vandaag    = TODAY()
			VAR WeekStart  = Vandaag - WEEKDAY( Vandaag, 2 ) + 1 - 14
			VAR WeekEind   = WeekStart + 6
			VAR HuidigItem = SELECTEDVALUE( StockOverview[Item] )
			RETURN
			CALCULATE(
			    -SUM( StockTransactions[Quantity] ),
			    REMOVEFILTERS( StockTransactions ),
			    REMOVEFILTERS( dates ),
			    StockTransactions[Item]   = HuidigItem,
			    StockTransactions[Status] = 21,
			    StockTransactions[Type]   IN { 120, 122 },
			    dates[Date] >= WeekStart,
			    dates[Date] <= WeekEind
			)
			
			```
		formatString: #,0
