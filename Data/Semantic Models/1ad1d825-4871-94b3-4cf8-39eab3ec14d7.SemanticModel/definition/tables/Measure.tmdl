	measure 'Inkoop Prognose Deze Week' =
			
			VAR refKeuze     = SELECTEDVALUE( referentieperiode[ReferentieID], 2 )
			VAR correctie    = DIVIDE( [Correctie %], 100, 0 )
			VAR huidigItem   = COALESCE( SELECTEDVALUE( StockOverview[Item] ), MAX( Items[ItemID] ) )
			VAR selWeekStart = TODAY() - WEEKDAY( TODAY(), 2 ) + 1
			
			// OPTIE 1: Vorig jaar ±2 weken
			VAR anker   = selWeekStart - 364
			VAR start5w = anker - 14
			VAR eind5w  = anker + 20
			VAR qty5w =
			    CALCULATE(
			        ABS( SUM( StockTransactions[Quantity] ) ),
			        REMOVEFILTERS( StockTransactions ),
			        REMOVEFILTERS( dates ),
			        StockTransactions[Item] = huidigItem,
			        StockTransactions[Status] = 21,
			        StockTransactions[Type] IN { 150, 155, 165 },
			        dates[Date] >= start5w,
			        dates[Date] <= eind5w
			    )
			VAR gem5w = DIVIDE( qty5w, 5 )
			
			// OPTIE 2: Laatste 4 weken
			VAR start4w = selWeekStart - 28
			VAR eind4w  = selWeekStart - 1
			VAR qty4w =
			    CALCULATE(
			        ABS( SUM( StockTransactions[Quantity] ) ),
			        REMOVEFILTERS( StockTransactions ),
			        REMOVEFILTERS( dates ),
			        StockTransactions[Item] = huidigItem,
			        StockTransactions[Status] = 21,
			        StockTransactions[Type] IN { 150, 155, 165 },
			        dates[Date] >= start4w,
			        dates[Date] <= eind4w
			    )
			VAR gem4w = DIVIDE( qty4w, 4 )
			
			// OPTIE 3: Laatste 10 weken
			VAR start10w = selWeekStart - 70
			VAR eind10w  = selWeekStart - 1
			VAR qty10w =
			    CALCULATE(
			        ABS( SUM( StockTransactions[Quantity] ) ),
			        REMOVEFILTERS( StockTransactions ),
			        REMOVEFILTERS( dates ),
			        StockTransactions[Item] = huidigItem,
			        StockTransactions[Status] = 21,
			        StockTransactions[Type] IN { 150, 155, 165 },
			        dates[Date] >= start10w,
			        dates[Date] <= eind10w
			    )
			VAR gem10w = DIVIDE( qty10w, 10 )
			
			VAR basis =
			    SWITCH(
			        refKeuze,
			        1, gem5w,
			        2, gem4w,
			        3, gem10w,
			        gem4w
			    )
			
			RETURN
			    ROUND( basis * ( 1 + correctie ), 0 )
		formatString: #,0
		lineageTag: 75e1a6fe-baa4-4831-8e82-1022411d6ee9

	measure 'Debug Inkoop Prognose' = ```
			
