	measure 'Stock op Peildatum' =
			
			VAR Datum = SELECTEDVALUE( PeilDatum[Date], TODAY() )
			VAR ValidTypes = {
			    120, 121, 122, 123, 124, 125, 130, 131, 132, 133, 134, 135,
			    140, 141, 147, 148, 150, 151, 155, 156, 160, 161, 165, 166,
			    196, 197
			}
			VAR HuidigeStock =
			    CALCULATE(
			        SUM( StockPositions[Stock] ),
			        StockPositions[Item]      IN VALUES( StockOverview[Item] ),
			        StockPositions[Warehouse] IN VALUES( StockOverview[Warehouse] )
			    )
			VAR MutatiesNaDatum =
			    CALCULATE(
			        SUM( StockTransactions[Quantity] ),
			        REMOVEFILTERS( StockTransactions ),
			        REMOVEFILTERS( dates ),
			        StockTransactions[Item]            IN VALUES( StockOverview[Item] ),
			        StockTransactions[Warehouse]       IN VALUES( StockOverview[Warehouse] ),
			        StockTransactions[Status]          = 21,
			        StockTransactions[Type]            IN ValidTypes,
			        StockTransactions[TransactionDate] > Datum
			    )
			RETURN
			    HuidigeStock - MutatiesNaDatum
		formatString: #,0
		lineageTag: 589aeaae-114b-41e1-9337-e9de79428b90

	measure 'Kostprijs op Peildatum' =
			
			VAR Datum = SELECTEDVALUE(PeilDatum[Date], TODAY())
			VAR CurrentItem = SELECTEDVALUE(StockOverview[Item])
			VAR CurrentWarehouse = SELECTEDVALUE(StockOverview[Warehouse])
			VAR LatestDate = CALCULATE(
			    MAX('StockTransactions'[TransactionDate]),
			    REMOVEFILTERS('StockTransactions'),
			    'StockTransactions'[Item] = CurrentItem,
			    'StockTransactions'[Warehouse] = CurrentWarehouse,
			    'StockTransactions'[TransactionDate] <= Datum,
			    'StockTransactions'[Status] = 21
			)
			VAR TxCost = CALCULATE(
			    AVERAGE('StockTransactions'[CostPrice]),
			    REMOVEFILTERS('StockTransactions'),
			    'StockTransactions'[Item] = CurrentItem,
			    'StockTransactions'[Warehouse] = CurrentWarehouse,
			    'StockTransactions'[TransactionDate] = LatestDate,
			    'StockTransactions'[Status] = 21
			)
			VAR ItemCost = LOOKUPVALUE(Items[CostPriceStandard], Items[ItemID], CurrentItem)
			VAR Result = IF(NOT ISBLANK(TxCost), TxCost, ItemCost)
			RETURN
			IF(
			    ISINSCOPE(StockOverview[ItemNameCode])
			    && COUNTROWS(VALUES(StockOverview[ItemNameCode])) = 1
			    && COUNTROWS(ALLSELECTED(StockOverview[ItemNameCode])) > COUNTROWS(VALUES(StockOverview[ItemNameCode])),
			    Result,
			    IF(
			        ISINSCOPE(StockOverview[ItemNameCode])
			        && COUNTROWS(ALLSELECTED(StockOverview[ItemNameCode])) = 1,
			        Result,
			        BLANK()
			    )
			)
		formatString: €#,##0.00
		lineageTag: 8a916750-0001-4ac1-9276-cd6e0f6f468d

	measure 'Voorraadwaarde op Peildatum' =
			
			VAR Datum = SELECTEDVALUE( PeilDatum[Date], TODAY() )
			RETURN
			SUMX(
			    SUMMARIZE( StockOverview, StockOverview[Item], StockOverview[Warehouse] ),
			    VAR CurItem = StockOverview[Item]
			    VAR CurWH   = StockOverview[Warehouse]
			
			    VAR Stk = [Stock op Peildatum]   // hergebruikt de gefixte logica per (Item, Warehouse)
			
			    VAR LatestDate = CALCULATE(
			        MAX( StockTransactions[TransactionDate] ),
			        REMOVEFILTERS( StockTransactions ),
			        REMOVEFILTERS( dates ),
			        StockTransactions[Item]            = CurItem,
			        StockTransactions[Warehouse]       = CurWH,
			        StockTransactions[TransactionDate] <= Datum,
			        StockTransactions[Status]          = 21,
			        StockTransactions[CostPrice]       <> 0
			    )
			    VAR TxCost = CALCULATE(
			        AVERAGE( StockTransactions[CostPrice] ),
			        REMOVEFILTERS( StockTransactions ),
			        REMOVEFILTERS( dates ),
			        StockTransactions[Item]            = CurItem,
			        StockTransactions[Warehouse]       = CurWH,
			        StockTransactions[TransactionDate] = LatestDate,
			        StockTransactions[Status]          = 21,
			        StockTransactions[CostPrice]       <> 0
			    )
			    VAR ItemCost = LOOKUPVALUE( Items[CostPriceStandard], Items[ItemID], CurItem )
			    VAR Kost     = COALESCE( TxCost, ItemCost )
			
			    RETURN IF( Stk <> 0 && NOT ISBLANK( Kost ), Stk * Kost, 0 )
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 810eeea5-46e4-44e5-8a86-eb6945763c0f

	measure 'Beschikbare Voorraad' =
			VAR StockQty = [Stock op Peildatum]
			VAR Reserved = CALCULATE(SUM(StockPositions[ReservedStock]), REMOVEFILTERS( StockPositions ),
			        StockPositions[Item] IN VALUES(StockOverview[Item]),
			        StockPositions[Warehouse] IN VALUES(StockOverview[Warehouse]))
			RETURN StockQty - COALESCE(Reserved, 0)
		formatString: #,##0.00
		lineageTag: f3493b61-0714-453a-9e52-71cc8c4402f8

	measure 'Geprojecteerde Voorraad' =
			VAR StockQty = [Stock op Peildatum]
			VAR Reserved = COALESCE(CALCULATE(SUM(StockPositions[ReservedStock]), REMOVEFILTERS( StockPositions ),
			        StockPositions[Item] IN VALUES(StockOverview[Item]),
			        StockPositions[Warehouse] IN VALUES(StockOverview[Warehouse])), 0)
			VAR ToBeReceived = COALESCE(CALCULATE(SUM(StockPositions[QuantityToBeReceived]), REMOVEFILTERS( StockPositions ),
			        StockPositions[Item] IN VALUES(StockOverview[Item]),
			        StockPositions[Warehouse] IN VALUES(StockOverview[Warehouse])), 0)
			VAR ToBeProduced = COALESCE(CALCULATE(SUM(StockPositions[QuantityToBeProduced]), REMOVEFILTERS( StockPositions ),
			        StockPositions[Item] IN VALUES(StockOverview[Item]),
			        StockPositions[Warehouse] IN VALUES(StockOverview[Warehouse])), 0)
			VAR ToBeDelivered = COALESCE(CALCULATE(SUM(StockPositions[QuantityToBeDelivered]), REMOVEFILTERS( StockPositions ),
			        StockPositions[Item] IN VALUES(StockOverview[Item]),
			        StockPositions[Warehouse] IN VALUES(StockOverview[Warehouse])), 0)
			VAR ToBeConsumed = COALESCE(CALCULATE(SUM(StockPositions[QuantityToBeConsumed]), REMOVEFILTERS( StockPositions ),
			        StockPositions[Item] IN VALUES(StockOverview[Item]),
			        StockPositions[Warehouse] IN VALUES(StockOverview[Warehouse])), 0)
			RETURN StockQty + ToBeReceived + ToBeProduced - ToBeDelivered - ToBeConsumed - Reserved
		formatString: #,##0.00
		lineageTag: 582a6630-0c09-4d91-ae58-0a12b98b2cd7

