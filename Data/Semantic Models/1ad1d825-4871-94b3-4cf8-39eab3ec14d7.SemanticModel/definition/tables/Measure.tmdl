	measure Kengetal = ```
			
			VAR Sel = SELECTEDVALUE(kengetallen[Kengetal])
			VAR SelPeriod = SELECTEDVALUE(gltransacties_fin[ReportingPeriod])
			VAR SelYear = MAX(dates[Year])
			VAR IsToekomst = 
			    ISBLANK(SelPeriod) 
			    || (SelYear = YEAR(TODAY()) && SelPeriod > MONTH(TODAY()))
			    || SelYear > YEAR(TODAY())
			VAR MinStatus =
			    IF(
			        NOT IsToekomst,
			        IF(
			            NOT ISBLANK(SelPeriod),
			            CALCULATE(
			                MIN(divisionperiodstatus[YearPeriodStatus]),
			                divisionperiodstatus[FinPeriod] = SelPeriod,
			                divisionperiodstatus[FinYear] = SelYear
			            ),
			            CALCULATE(
			                MIN(divisionperiodstatus[YearPeriodStatus]),
			                divisionperiodstatus[FinYear] = SelYear
			            )
			        )
			    )
			VAR PeriodStatus = IF(MinStatus = 1, "Definitief", "Concept")
			RETURN
			IF(
			    IsToekomst && Sel = "Status",
			    BLANK(),
			    SWITCH(
			        Sel,
			        "Personeelskosten %", REPT(UNICHAR(160), 10) & FORMAT(DIVIDE([Personeelskosten], [Omzet GL]), "0%"),
			        "Bruto marge %",      REPT(UNICHAR(160), 10) & FORMAT(DIVIDE([Omzet GL] - [Inkoopwaarde], [Omzet GL]), "0%"),
			        "Resultaat %",        REPT(UNICHAR(160), 10) & FORMAT(DIVIDE([Bedrag P&L], [Omzet GL]), "0%"),
			        "Status",             PeriodStatus
			    )
			)
			```
		lineageTag: 884f7f06-7c73-42c7-bff7-189be98e6752

