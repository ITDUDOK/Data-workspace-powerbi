	measure 'Is Datum Geldig Item Today' =
			
			VAR Datum1     = SELECTEDVALUE(dates[Date], TODAY())
			VAR huidigItem = SELECTEDVALUE(Items[ItemID])
			VAR keuze      = SELECTEDVALUE(datumgeldigfilter[Waarde], 0)
			VAR Datum2     = CALCULATE(
			    MAX(Items[EndDate]),
			    REMOVEFILTERS( Items ),
			        Items[ItemID] = huidigItem
			)
			VAR isGeldig   =
			    IF(
			        ISBLANK(Datum2),
			        1,
			        IF(Datum1 < Datum2, 1, 0)
			    )
			RETURN
			    IF(keuze = 0, 1, isGeldig)
