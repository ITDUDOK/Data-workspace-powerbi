	measure 'Voorraad Verschil' =
			
			VAR selStart   = MIN( dates[Date] )
			VAR selEind    = MAX( dates[Date] )
			VAR huidigItem = COALESCE( SELECTEDVALUE( StockOverview[Item] ), MAX( Items[ItemID] ) )
			VAR huidigCount = SELECTEDVALUE( StockCounts[StockCountNumber] )
			VAR _result =
			    IF(
			        ISINSCOPE( StockCounts[StockCountNumber] ),
			        CALCULATE(
			            ABS( SUM( StockCounts[Quantity] ) ),
			            REMOVEFILTERS( StockCounts ),
			            StockCounts[Item] = huidigItem,
			            StockCounts[StockCountNumber] = huidigCount,
			            StockCounts[TransactionDate] >= selStart,
			            StockCounts[TransactionDate] <= selEind
			        ),
			        CALCULATE(
			            ABS( SUM( StockCounts[Quantity] ) ),
			            REMOVEFILTERS( StockCounts ),
			            StockCounts[Item] = huidigItem,
			            StockCounts[TransactionDate] >= selStart,
			            StockCounts[TransactionDate] <= selEind
			        )
			    )
			RETURN
			IF( _result <> 0, _result )
		formatString: #,0
		lineageTag: 7c7296d2-ca5e-4847-8485-a5cd1ef3842a

	measure 'Voorraad Verschil Waarde' =
			
			VAR selStart   = MIN( dates[Date] )
			VAR selEind    = MAX( dates[Date] )
			VAR huidigItem = COALESCE( SELECTEDVALUE( StockOverview[Item] ), MAX( Items[ItemID] ) )
			VAR huidigCount = SELECTEDVALUE( StockCounts[StockCountNumber] )
			VAR _result =
			    IF(
			        ISINSCOPE( StockCounts[StockCountNumber] ),
			        CALCULATE(
			            ABS( SUMX( StockCounts, StockCounts[Quantity] * StockCounts[CostPrice] ) ),
			            REMOVEFILTERS( StockCounts ),
			            StockCounts[Item] = huidigItem,
			            StockCounts[StockCountNumber] = huidigCount,
			            StockCounts[TransactionDate] >= selStart,
			            StockCounts[TransactionDate] <= selEind
			        ),
			        CALCULATE(
			            ABS( SUMX( StockCounts, StockCounts[Quantity] * StockCounts[CostPrice] ) ),
			            REMOVEFILTERS( StockCounts ),
			            StockCounts[Item] = huidigItem,
			            StockCounts[TransactionDate] >= selStart,
			            StockCounts[TransactionDate] <= selEind
			        )
			    )
			RETURN
			IF( _result <> 0, _result )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 4b6cb034-2458-4f6d-aa8e-e8d1736040bb

