	measure 'Productie Deze Week' = ```
			
			
			VAR huidigItem    = SELECTEDVALUE( StockOverview[Item] )
			VAR selWeekStart  = MIN( dates[Date] )
			VAR selWeekEind   = MAX( dates[Date] )
			
			VAR result =
			    CALCULATE(
			        SUM( ShopOrders[PlannedQuantity] ),
			        REMOVEFILTERS( ShopOrders ),
			        ShopOrders[Item] = huidigItem,
			        ShopOrders[PlannedEndDate] >= selWeekStart,   
			        ShopOrders[PlannedEndDate] <= selWeekEind,
			        ShopOrders[Status] IN { 10, 20 }
			    )
			
			RETURN
			    IF( ISBLANK( result ), 0, result )
			```
		lineageTag: 2bee6c98-f043-4ca6-ae94-265e1b201e2c

