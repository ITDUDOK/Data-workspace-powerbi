		sourceColumn: WerklocatieOfficeId

		annotation SummarizationSetBy = Automatic

	column WerklocatieOfficeName
		dataType: string
		lineageTag: ff7461c1-8f3c-49e6-bea0-7f1714ef2a15
		sourceLineageTag: WerklocatieOfficeName
		summarizeBy: none
		sourceColumn: WerklocatieOfficeName

		annotation SummarizationSetBy = Automatic

	column TotalHours
		dataType: decimal
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: bf1271a8-e1e7-4c61-ad0b-f1bde83ccdf7
		sourceLineageTag: TotalHours
