table employee_worklocation_monthly
	lineageTag: d2d41bfc-5dc2-450d-952f-c9910fc904bc
	sourceLineageTag: [dbo].[employee_worklocation_monthly]

	measure WerklocatieHuidigeMaand =
			VAR HuidigEmployeeId = SELECTEDVALUE(contracts_enriched[EmployeeId])
			VAR SelectedYear = COALESCE(SELECTEDVALUE(dates[Year]), YEAR(TODAY()))
			VAR SelectedMonth = COALESCE(SELECTEDVALUE(dates[Month]), MONTH(TODAY()))
			RETURN
			IF(
			    ISBLANK(HuidigEmployeeId),
			    BLANK(),
			    CALCULATE(
			        SELECTEDVALUE(employee_worklocation_monthly[WerklocatieOfficeName]),
			        REMOVEFILTERS(employee_worklocation_monthly),
			        employee_worklocation_monthly[EmployeeId] = HuidigEmployeeId,
			        YEAR(employee_worklocation_monthly[YearMonth]) = SelectedYear,
			        MONTH(employee_worklocation_monthly[YearMonth]) = SelectedMonth
			    )
			)
		lineageTag: fea829a8-f073-43f7-9403-072c400d6141

	column EmployeeId
		dataType: string
		lineageTag: 861d1448-8fa6-4b5d-8a36-77a9dfa24e44
		sourceLineageTag: EmployeeId
		summarizeBy: none
		sourceColumn: EmployeeId

		annotation SummarizationSetBy = Automatic

	column YearMonth
		dataType: dateTime
		formatString: General Date
		lineageTag: 863f02fb-519e-49a5-9d15-a401bacce840
		sourceLineageTag: YearMonth
		summarizeBy: none
		sourceColumn: YearMonth

		annotation SummarizationSetBy = Automatic

	column WerklocatieOfficeId
