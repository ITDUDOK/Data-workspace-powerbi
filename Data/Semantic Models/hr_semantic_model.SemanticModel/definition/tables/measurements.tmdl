	measure Tevredenheidscijfer =
			VAR HuidigCardName = SELECTEDVALUE('bridge_employees'[CardName])
			VAR HuidigFullName = SELECTEDVALUE('bridge_employees'[FullName])
			VAR SelectedYear = IF(HASONEVALUE('dim_date'[Year]), VALUES('dim_date'[Year]), YEAR(TODAY()))
			VAR SelectedMonth = IF(HASONEVALUE('dim_date'[Month]), VALUES('dim_date'[Month]), MONTH(TODAY()))
			VAR VorigeMaandDate = EDATE(DATE(SelectedYear, SelectedMonth, 1), -1)
			VAR VorigeYear = YEAR(VorigeMaandDate)
			VAR VorigeMonth = MONTH(VorigeMaandDate)
			VAR Responses =
			    CALCULATE(
			        COUNTROWS('fact_satisfaction'),
			        'fact_satisfaction'[StaffName] = HuidigCardName
			            || 'fact_satisfaction'[StaffName] = HuidigFullName,
			        REMOVEFILTERS('dim_date'),
			        'dim_date'[Year] = VorigeYear,
			        'dim_date'[Month] = VorigeMonth
			    )
			VAR Gewogen =
			    CALCULATE(
			        SUMX('fact_satisfaction', 'fact_satisfaction'[Satisfaction] * 2),
			        'fact_satisfaction'[StaffName] = HuidigCardName
			            || 'fact_satisfaction'[StaffName] = HuidigFullName,
			        REMOVEFILTERS('dim_date'),
			        'dim_date'[Year] = VorigeYear,
			        'dim_date'[Month] = VorigeMonth
			    )
			RETURN
			    IF(Responses > 0, DIVIDE(Gewogen, Responses))
		lineageTag: 44ea1727-338b-4874-9597-770014002649

	measure Einddatum_Contract =
