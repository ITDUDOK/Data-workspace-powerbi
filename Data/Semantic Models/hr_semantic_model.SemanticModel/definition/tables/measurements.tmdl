	measure OverHoursSom =
			VAR SelectedYear =
			    IF(
			        HASONEVALUE('dim_date'[Year]),
			        VALUES('dim_date'[Year]),
			        YEAR(TODAY())
			    )
			
			VAR IsMonthMode = SelectedYear >= 2026
			
			VAR SelectedMonth = IF(HASONEVALUE('dim_date'[Month]), VALUES('dim_date'[Month]), MONTH(TODAY()))
			VAR VorigeMaand = EDATE(DATE(SelectedYear, SelectedMonth, 1), -1)
			VAR VorigeYearMonth = FORMAT(VorigeMaand, "YYYY-MM")
			
			VAR Result =
			    IF(
			        IsMonthMode,
			        IF(
			            HASONEVALUE('dim_staff'[CardID]),
			            CALCULATE(
			                AVERAGE('fact_cumulative'[CummOverHours]),
			                REMOVEFILTERS('dim_date'),
			                'fact_cumulative'[YearMonth] = VorigeYearMonth
			            ),
			            SUMX(
			                VALUES('dim_staff'[CardID]),
			                CALCULATE(
			                    AVERAGE('fact_cumulative'[CummOverHours]),
			                    REMOVEFILTERS('dim_date'),
			                    'fact_cumulative'[YearMonth] = VorigeYearMonth
			                )
			            )
			        ),
			        IF(
			            HASONEVALUE('dim_staff'[CardID]),
			            CALCULATE(
			                AVERAGE('fact_cumulative'[CummOverHours]),
			                USERELATIONSHIP('fact_cumulative'[YearWeek], 'dim_date'[YearWeek])
			            ),
			            SUMX(
			                VALUES('dim_staff'[CardID]),
			                CALCULATE(
			                    AVERAGE('fact_cumulative'[CummOverHours]),
			                    USERELATIONSHIP('fact_cumulative'[YearWeek], 'dim_date'[YearWeek])
			                )
			            )
			        )
			    )
			
			RETURN Result
		lineageTag: fb90ffa8-687a-4882-8182-7c1995771f0a

