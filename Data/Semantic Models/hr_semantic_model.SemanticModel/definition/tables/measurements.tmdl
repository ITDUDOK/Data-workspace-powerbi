	measure Netto_GewerktUren_Vast =
			VAR VastHours =
			    CALCULATE(
			        SUMX(
			            'fact_hours',
			            IF(
			                'fact_hours'[OfficeID] = 'fact_hours'[HourOfficeID] && 'fact_hours'[OfficeID] <> 11,
			                'fact_hours'[HourHours],
			                0
			            )
			        ),
			        USERELATIONSHIP('fact_hours'[HourDepartmentID], 'dim_departments'[DepartmentID]),
			        USERELATIONSHIP('fact_hours'[HourOfficeID], 'dim_offices'[OfficeID]),
			        USERELATIONSHIP('dim_departments'[DepartmentID], 'fact_planning'[PlanningDepartmentID])
			    )
			RETURN
			    VastHours
		lineageTag: 7c1981b4-7396-420b-ab4c-0921880be0ba

