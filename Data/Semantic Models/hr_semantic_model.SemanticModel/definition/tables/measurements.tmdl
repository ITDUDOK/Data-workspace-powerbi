	measure Employee_In_Department =
			VAR CurrentEmployee = SELECTEDVALUE('bridge_employees'[FullName])
			VAR CurrentDepartment = SELECTEDVALUE('bridge_employees'[DepartmentName])
			VAR EmployeeInThisDept =
			    CALCULATE(
			        COUNTROWS('bridge_employees'),
			        'bridge_employees'[FullName] = CurrentEmployee,
			        'bridge_employees'[DepartmentName] = CurrentDepartment
			    )
			RETURN
