	measure Employee_Age =
			IF(
			    HASONEVALUE('bridge_employees'[FullName]),
			    VAR BirthDate = MIN('bridge_employees'[CardDateofBirth])
			    VAR CurrentDate = TODAY()
			    VAR Age =
			        IF(
			            NOT ISBLANK(BirthDate),
			            DATEDIFF(BirthDate, CurrentDate, YEAR),
			            BLANK()
			        )
			    RETURN Age,
			    BLANK()
			)
