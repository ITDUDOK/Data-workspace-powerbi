	measure Werklocatie =
			VAR GekozenData = VALUES('dim_date'[Date])
			VAR HeeftSelectie = NOT ISEMPTY(GekozenData)
			VAR MinDate = IF(HeeftSelectie, MINX(GekozenData, 'dim_date'[Date]), TODAY())
			VAR MaxDate = IF(HeeftSelectie, MAXX(GekozenData, 'dim_date'[Date]), TODAY())
			VAR HuidigCardName = SELECTEDVALUE('fact_hours'[CardName])
			VAR UrenPerLocatie =
			    FILTER(
			        ADDCOLUMNS(
			            CALCULATETABLE(
			                VALUES('fact_hours'[HourOfficeID]),
			                REMOVEFILTERS('dim_date'),
			                REMOVEFILTERS('fact_hours'),
			                'fact_hours'[CardName] = HuidigCardName,
			                'fact_hours'[HourDate] >= MinDate,
			                'fact_hours'[HourDate] <= MaxDate
			            ),
			            "TotaalUren", CALCULATE(
			                SUM('fact_hours'[HourHours]),
			                REMOVEFILTERS('dim_date'),
			                'fact_hours'[CardName] = HuidigCardName,
			                'fact_hours'[HourDate] >= MinDate,
			                'fact_hours'[HourDate] <= MaxDate
			            )
			        ),
			        [TotaalUren] > 0
			    )
			VAR MaxUren = MAXX(UrenPerLocatie, [TotaalUren])
			VAR TopOfficeID =
			    MAXX(
			        FILTER(UrenPerLocatie, [TotaalUren] = MaxUren),
			        'fact_hours'[HourOfficeID]
			    )
			RETURN
			    IF(
			        NOT ISBLANK(HuidigCardName),
			        LOOKUPVALUE(
			            'dim_offices'[OfficeName],
			            'dim_offices'[OfficeID],
			            TopOfficeID
			        )
			    )
		lineageTag: ff1a460e-8077-4aec-86a4-219e732b4cd3

	measure Werklocatie_Filter_VorigeMaand_MA =
			VAR HuidigCardID = SELECTEDVALUE('bridge_employees'[CardID])
			
			VAR SelectedYear  = IF(HASONEVALUE('dim_date'[Year]),  VALUES('dim_date'[Year]),  YEAR(TODAY()))
			VAR SelectedMonth = IF(HASONEVALUE('dim_date'[Month]), VALUES('dim_date'[Month]), MONTH(TODAY()))
			VAR VorigeMaand   = EDATE(DATE(SelectedYear, SelectedMonth, 1), -1)
			VAR VorigeYear    = YEAR(VorigeMaand)
			VAR VorigeMonth   = MONTH(VorigeMaand)
			
			VAR UrenPerLocatie =
			    ADDCOLUMNS(
			        CALCULATETABLE(
			            VALUES('fact_hours'[HourOfficeID]),
			            REMOVEFILTERS('fact_hours'),
			            REMOVEFILTERS('dim_date'),
			            'fact_hours'[CardID] = HuidigCardID,
			            'dim_date'[Year]  = VorigeYear,
			            'dim_date'[Month] = VorigeMonth
			        ),
			        "TotaalUren", CALCULATE(
			            SUM('fact_hours'[HourHours]),
			            REMOVEFILTERS('fact_hours'),
			            REMOVEFILTERS('dim_date'),
			            'fact_hours'[CardID] = HuidigCardID,
			            'dim_date'[Year]  = VorigeYear,
			            'dim_date'[Month] = VorigeMonth
			        )
			    )
			VAR MaxUren     = MAXX(UrenPerLocatie, [TotaalUren])
			VAR TopOfficeID =
			    MAXX(FILTER(UrenPerLocatie, [TotaalUren] = MaxUren), 'fact_hours'[HourOfficeID])
			
			VAR EffectiefOfficeID =
			    IF(
			        NOT ISBLANK(TopOfficeID),
			        TopOfficeID,
			        SELECTEDVALUE('bridge_employees'[OfficeID])
			    )
			
			VAR GeselOffices  = VALUES('dim_offices'[OfficeID])
			VAR HeeftSelectie =
			    COUNTROWS(GeselOffices) < COUNTROWS(ALL('dim_offices'[OfficeID]))
			
			RETURN
			    IF(
			        ISBLANK(HuidigCardID),
			        BLANK(),
			        IF(
			            NOT HeeftSelectie,
			            1,
			            IF(CONTAINSROW(GeselOffices, EffectiefOfficeID), 1, BLANK())
			        )
			    )
		formatString: 0
		lineageTag: f0a6e96d-87e8-4fb9-a7e0-919a131502fd

	measure CardID_MA_Gekozen_OpNaam =
			VAR CurrentName =
			    SELECTEDVALUE( 'bridge_employees'[CardName] )
			
			VAR SelectedYear  = COALESCE( SELECTEDVALUE( 'dim_date'[YearISO] ), YEAR( TODAY() ) )
			VAR SelectedMonth = COALESCE( SELECTEDVALUE( 'dim_date'[Month] ), MONTH( TODAY() ) )
			VAR StartDatum    = DATE( SelectedYear, SelectedMonth, 1 )
			VAR EindDatum     = EOMONTH( StartDatum, 0 )
			VAR Peildatum     = MIN( EindDatum, TODAY() )
			
			VAR CandidateRows =
			    ADDCOLUMNS(
			        FILTER(
			            ALL( 'bridge_employees' ),
			            'bridge_employees'[CardName] = CurrentName
			        ),
			        "__EffStart",
			            COALESCE(
			                'bridge_employees'[EmployeeStartDate],
			                'bridge_employees'[CardStart],
			                DATE( 1900, 1, 1 )
			            ),
			        "__EffEnd",
			            COALESCE(
			                'bridge_employees'[EmployeeEndDate],
			                'bridge_employees'[CardEnd],
			                DATE( 2099, 12, 31 )
			            )
			    )
			
			VAR OverlappendRows =
			    FILTER(
			        CandidateRows,
			        [__EffStart] <= EindDatum && [__EffEnd] >= StartDatum
			    )
			
			VAR BestRow =
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            OverlappendRows,
			            "__ActiveAtStart",  IF( [__EffStart] <= StartDatum && [__EffEnd] >= StartDatum, 1, 0 ),
			            "__ActiveAtPeil",   IF( [__EffStart] <= Peildatum  && [__EffEnd] >= Peildatum,  1, 0 )
			        ),
			        [__ActiveAtStart], DESC,
			        [__ActiveAtPeil],  DESC,
			        [__EffStart],      DESC,
			        'bridge_employees'[CardID], DESC
			    )
			
			RETURN
			    MAXX( BestRow, 'bridge_employees'[CardID] )
		lineageTag: 236c6ed8-79c5-4ab1-9ca6-7b98052ad6c3

	measure MA_Gekozen_CardID_Filter =
			VAR CurrentCardID =
			    SELECTEDVALUE( 'bridge_employees'[CardID] )
			
			VAR GekozenCardID =
			    [CardID_MA_Gekozen_OpNaam]
			
			RETURN
			    IF(
			        ISBLANK( CurrentCardID ) || ISBLANK( GekozenCardID ),
			        1,
			        IF( CurrentCardID = GekozenCardID, 1, 0 )
			    )
		formatString: 0
		lineageTag: 815a8cbd-4723-4f24-9f36-a766115c445e

	measure EndDatum_Actief_Filter_MA =
			VAR SelectedYear  = COALESCE( SELECTEDVALUE( 'dim_date'[YearISO] ), YEAR( TODAY() ) )
			VAR SelectedMonth = COALESCE( SELECTEDVALUE( 'dim_date'[Month] ),  MONTH( TODAY() ) )
			VAR MaandStart    = DATE( SelectedYear, SelectedMonth, 1 )
			VAR MaandEind     = EOMONTH( MaandStart, 0 )
			
			VAR MaxEinde =
			    CALCULATE(
			        MAX( 'bridge_employees'[EmployeeEndDate] ),
			        ALLEXCEPT( 'bridge_employees', 'bridge_employees'[CardName] )
			    )
			
			VAR MinStart =
			    CALCULATE(
			        MIN( 'bridge_employees'[EmployeeStartDate] ),
			        ALLEXCEPT( 'bridge_employees', 'bridge_employees'[CardName] )
			    )
			
			RETURN
			    IF(
			        ( ISBLANK( MinStart ) || MinStart <= MaandEind )
			        && ( ISBLANK( MaxEinde ) || MaxEinde >= MaandStart ),
			        1,
			        BLANK()
			    )
		formatString: 0
		lineageTag: 7c7a93db-8a71-4a67-b33e-dea852c36d30

	measure Contractlocatie_MA =
			VAR HuidigCardID = [CardID_MA_Gekozen_OpNaam]
			VAR OfficeID =
			    CALCULATE(
			        SELECTEDVALUE( 'bridge_employees'[OfficeID] ),
			        'bridge_employees'[CardID] = HuidigCardID
			    )
			VAR OfficeNaam =
			    LOOKUPVALUE(
			        'dim_offices'[OfficeName],
			        'dim_offices'[OfficeID],
			        OfficeID
			    )
			VAR LocatieViaUren =
			    LOOKUPVALUE(
			        'dim_offices'[OfficeName],
			        'dim_offices'[OfficeID],
			        CALCULATE(
			            MAX('fact_hours'[OfficeID]),
			            'fact_hours'[CardID] = HuidigCardID
			        )
			    )
			RETURN
			    IF(
			        NOT ISBLANK(HuidigCardID),
			        IF(
			            NOT ISBLANK(OfficeNaam),
			            OfficeNaam,
			            LocatieViaUren
			        )
			    )
		lineageTag: 7d10f89e-cb35-4d7c-886a-a2b5a5a5679f

	measure Functie_MA =
			VAR HuidigCardID = [CardID_MA_Gekozen_OpNaam]
			RETURN
			    IF(
			        ISBLANK( HuidigCardID ),
			        BLANK(),
			        CALCULATE(
			            SELECTEDVALUE( 'bridge_employees'[EmployeeFunctionDescription] ),
			            'bridge_employees'[CardID] = HuidigCardID
			        )
			    )
		lineageTag: e02eac6b-2d9b-4585-b7fe-2151236ac718

	measure DEBUG_CardID_Gekozen =
			VAR CurrentName = SELECTEDVALUE( 'bridge_employees'[CardName] )
			VAR SelectedYear  = COALESCE( SELECTEDVALUE( 'dim_date'[YearISO] ), YEAR( TODAY() ) )
			VAR SelectedMonth = COALESCE( SELECTEDVALUE( 'dim_date'[Month] ), MONTH( TODAY() ) )
			VAR StartDatum = DATE( SelectedYear, SelectedMonth, 1 )
			VAR EindDatum  = EOMONTH( StartDatum, 0 )
			
			VAR AlleRijen =
			    COUNTROWS( FILTER( ALL( 'bridge_employees' ), 'bridge_employees'[CardName] = CurrentName ) )
			
			VAR OverlapRijen =
			    COUNTROWS(
			        FILTER(
			            ALL( 'bridge_employees' ),
			            'bridge_employees'[CardName] = CurrentName
			                && COALESCE( 'bridge_employees'[EmployeeStartDate], 'bridge_employees'[CardStart], DATE(1900,1,1) ) <= EindDatum
			                && COALESCE( 'bridge_employees'[EmployeeEndDate],   'bridge_employees'[CardEnd],   DATE(2099,12,31) ) >= StartDatum
			        )
			    )
			
			VAR GekozenID = [CardID_MA_Gekozen_OpNaam]
			
			RETURN
			    "Naam=" & CurrentName
			    & " | Jaar=" & SelectedYear
			    & " | Maand=" & SelectedMonth
			    & " | AlleRijen=" & AlleRijen
			    & " | OverlapRijen=" & OverlapRijen
			    & " | GekozenCardID=" & COALESCE( FORMAT( GekozenID, "0" ), "BLANK" )
		lineageTag: 51852ca8-a7cc-441f-8325-de1037ec78e8

	measure Medewerker_Actief_In_Periode =
			VAR SelectedStartDate = MIN('dim_date'[Date])
			VAR SelectedEndDate = MAX('dim_date'[Date])
			VAR EmpEnd = SELECTEDVALUE('bridge_employees'[EmployeeEndDate])
			VAR EmpStart = SELECTEDVALUE('bridge_employees'[EmployeeStartDate])
			RETURN
			IF(
			    ISBLANK(SelectedStartDate),
			    1,
			    IF(
			        EmpStart <= SelectedEndDate && EmpEnd >= SelectedStartDate,
			        1,
			        0
			    )
			)
		formatString: 0
		lineageTag: 4dd7ee0e-867f-4c58-a19a-efc686f06355

	measure Ziekmeldingen_6M =
			VAR HuidigCardID = [CardID_MA_Gekozen_OpNaam]
			VAR Grens = EDATE(TODAY(), -6)
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT('fact_sickness'[MeldingID]),
			        REMOVEFILTERS('dim_date'),
			        'fact_sickness'[CardID] = HuidigCardID,
			        'fact_sickness'[SicknessStart] >= Grens
			    )
		formatString: 0
