table measurements
	lineageTag: 95d1c26a-5ab3-45c0-be82-502c3fa45503

	measure Netto_GewerktUren =
			VAR GeselecteerdOffice = VALUES('dim_offices'[OfficeID])
			VAR AlleUren =
			    CALCULATETABLE(
			        SUMMARIZE(
			            'fact_hours',
			            'fact_hours'[HourID],
			            'fact_hours'[HourDepartmentID],
			            "Uren", MAX('fact_hours'[HourHours]),
			            "ThuisOfficeID", MAX('fact_hours'[OfficeID]),
			            "WerkOfficeID", MAX('fact_hours'[HourOfficeID])
			        ),
			        ALL('dim_offices'),
			        ALL('dim_departments')
			    )
			VAR GefilterdOpOffice =
			    FILTER(
			        AlleUren,
			        [ThuisOfficeID] IN GeselecteerdOffice || [WerkOfficeID] IN GeselecteerdOffice
			    )
			VAR GefilterdOpDepartment =
			    FILTER(
			        GefilterdOpOffice,
			        CALCULATE(
			            COUNTROWS('dim_departments'),
			            'dim_departments'[DepartmentID] = EARLIER('fact_hours'[HourDepartmentID])
			        ) > 0
			    )
			RETURN
			    SUMX(GefilterdOpDepartment, [Uren])
		formatString: #,0
		lineageTag: 9ed6f8ad-a338-412b-ad82-482ef7c4c65d

