	measure Ziekteverzuim_Percentage_Locatie =
			VAR GekozenData = VALUES('dim_date'[Date])
			VAR HeeftSelectie = NOT ISEMPTY(GekozenData)
			VAR MinDate = IF(HeeftSelectie, MINX(GekozenData, 'dim_date'[Date]), TODAY())
			VAR MaxDate = IF(HeeftSelectie, MAXX(GekozenData, 'dim_date'[Date]), TODAY())
			
			VAR ZiekteUren =
			    CALCULATE(
			        SUM('fact_sickness'[SicknessHours]),
			        REMOVEFILTERS('dim_date'),
			        KEEPFILTERS(
			            FILTER(
			                ALL('fact_sickness'),
			                'fact_sickness'[SicknessStart] >= MinDate &&
			                'fact_sickness'[SicknessStart] <= MaxDate
			            )
			        )
			    )
			
			VAR GewerkteUren =
			    CALCULATE(
			        SUM('fact_hours'[HourHours]),
			        REMOVEFILTERS('dim_date'),
			        KEEPFILTERS(
			            FILTER(
			                ALL('fact_hours'),
			                'fact_hours'[HourDate] >= MinDate &&
			                'fact_hours'[HourDate] <= MaxDate
			            )
			        )
			    )
			
			RETURN
			IF(
			    GewerkteUren > 0,
			    DIVIDE(ZiekteUren, GewerkteUren, 0) * 100,
			    0
			)
		lineageTag: 5351f5fd-b1ae-455d-be6e-d325d59ba17b

	measure Ziekteverzuim_Percentage =
			VAR GekozenData = VALUES('dim_date'[Date])
			VAR HeeftSelectie = NOT ISEMPTY(GekozenData)
			VAR MinDate = IF(HeeftSelectie, MINX(GekozenData, 'dim_date'[Date]), TODAY())
			VAR MaxDate = IF(HeeftSelectie, MAXX(GekozenData, 'dim_date'[Date]), TODAY())
			
			VAR ZiekteUren =
			    CALCULATE(
			        SUMX(
			            'fact_sickness',
			            VAR SicknessStart = 'fact_sickness'[SicknessStart]
			            VAR SicknessEnd = IF(ISBLANK('fact_sickness'[SicknessEnd]), TODAY(), 'fact_sickness'[SicknessEnd])
			            VAR OverlapStart = MAX(SicknessStart, MinDate)
			            VAR OverlapEnd = MIN(SicknessEnd, MaxDate)
			            RETURN
			            IF(
			                OverlapStart <= OverlapEnd,
			                'fact_sickness'[SicknessHours] *
			                DIVIDE(OverlapEnd - OverlapStart + 1, SicknessEnd - SicknessStart + 1, 0),
			                0
			            )
			        ),
			        REMOVEFILTERS('dim_date')
			    )
			
			VAR GewerkteUren =
			    CALCULATE(
			        SUM('fact_hours'[HourHours]),
			        REMOVEFILTERS('dim_date'),
			        KEEPFILTERS(
			            FILTER(
			                ALL('fact_hours'),
			                'fact_hours'[HourDate] >= MinDate &&
			                'fact_hours'[HourDate] <= MaxDate
			            )
			        )
			    )
			
			RETURN
			IF(
			    GewerkteUren > 0,
			    DIVIDE(ZiekteUren, GewerkteUren, 0),
			    0
			)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 58daf079-3356-40b2-b33e-c1c62b45ca58

	measure AantalActieveWerknemers =
			CALCULATE(
			    DISTINCTCOUNT('fact_hrcontracts'[employeeId]),
			    'fact_hrcontracts'[IsLatestContract] = TRUE()
			)
		formatString: 0
		lineageTag: 586cf6ac-83e2-474d-8d8f-d12474e36d22

	measure FTE_Berekening_Actieve_Contracten =
			VAR GekozenData = VALUES('dim_date'[Date])
			VAR HeeftSelectie = NOT ISEMPTY(GekozenData)
			VAR MinDate = IF(HeeftSelectie, MINX(GekozenData, 'dim_date'[Date]), TODAY())
			VAR MaxDate = IF(HeeftSelectie, MAXX(GekozenData, 'dim_date'[Date]), TODAY())
			
			RETURN
			CALCULATE(
			    SUMX(
			        VALUES('fact_hrcontracts'[employeeId]),
			        VAR CurrentEmployee = 'fact_hrcontracts'[employeeId]
			        VAR ActiveContractHours =
			            CALCULATE(
			                MAX('fact_hrcontracts'[hoursPerWeek]),
			                'fact_hrcontracts'[employeeId] = CurrentEmployee,
			                'fact_hrcontracts'[startDate] <= MaxDate,
			                (
			                    'fact_hrcontracts'[indefinite] = TRUE() ||
			                    ISBLANK('fact_hrcontracts'[endDate]) ||
			                    'fact_hrcontracts'[endDate] >= MinDate
			                )
			            )
			        RETURN
			        IF(
			            ISBLANK(ActiveContractHours),
			            0,
			            DIVIDE(ActiveContractHours, 38, 0)
			        )
			    ),
			    REMOVEFILTERS('dim_date'),
			    KEEPFILTERS(
			        FILTER(
			            ALL('fact_hrcontracts'),
			            'fact_hrcontracts'[startDate] <= MaxDate
			            &&
			            (
			                'fact_hrcontracts'[indefinite] = TRUE() ||
			                ISBLANK('fact_hrcontracts'[endDate]) ||
			                'fact_hrcontracts'[endDate] >= MinDate
			            )
			        )
			    )
			)
		lineageTag: 338b47a1-4b2b-47d7-a352-cb216dff7d75

