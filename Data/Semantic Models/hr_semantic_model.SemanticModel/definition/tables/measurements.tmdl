	measure Function_First =
			VAR MinSatisfactionDate =
			    CALCULATE(
			        MIN('fact_satisfaction'[Date]),
			        FILTER('fact_satisfaction',
			               'fact_satisfaction'[StaffName] = SELECTEDVALUE('fact_satisfaction'[StaffName]))
			    )
			
			VAR MaxValidCardStart =
			    CALCULATE(
			        MAX('bridge_employees'[CardStart]),
			        FILTER('bridge_employees',
			               'bridge_employees'[CardName] = SELECTEDVALUE('fact_satisfaction'[StaffName]) &&
			               'bridge_employees'[CardStart] <= MinSatisfactionDate)
			    )
			
			RETURN
			CALCULATE(
			    SELECTEDVALUE('bridge_employees'[EmployeeFunctionDescription]),
			    FILTER('bridge_employees',
			           'bridge_employees'[CardName] = SELECTEDVALUE('fact_satisfaction'[StaffName]) &&
			           'bridge_employees'[CardStart] = MaxValidCardStart)
			)
		lineageTag: a7daf5ae-8235-4a8f-b6b0-d65dc53d19e4

	measure 'Staff Unique Value' = CALCULATE(COUNTROWS('fact_satisfaction'), VALUES('fact_satisfaction'[StaffName]))
