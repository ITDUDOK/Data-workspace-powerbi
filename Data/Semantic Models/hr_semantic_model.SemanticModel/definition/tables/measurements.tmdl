	measure AantalActieveWerknemers_MetWeekFilter =
			CALCULATE(
			    DISTINCTCOUNT('fact_hrcontracts'[employeeId]),
			    'fact_hrcontracts'[IsLatestContract] = TRUE(),
			    FILTER(
			        'fact_hrcontracts',
			        VAR MaxDate = 'fact_hrcontracts'[startDate]
			        VAR EersteDagVolgendePeriode = EOMONTH(MaxDate, 0) + 1
			        RETURN
			            'fact_hrcontracts'[startDate] <= MaxDate
			            && (ISBLANK('fact_hrcontracts'[endDate]) || 'fact_hrcontracts'[endDate] >= EersteDagVolgendePeriode)
			    )
			)
		formatString: 0
		lineageTag: a63acbf3-9d01-4c19-976d-723fce457889

