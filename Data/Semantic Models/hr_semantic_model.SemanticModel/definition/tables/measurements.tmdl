	measure 'Gem. Arbeidsduur (jaren)' =
			VAR ReferenceDate = TODAY()
			RETURN
			AVERAGEX(
			    'bridge_employees',
			    VAR FinalStartDate = COALESCE('bridge_employees'[SeniorityDate], 'bridge_employees'[HRContractStartDate], 'bridge_employees'[CardStart])
			    VAR ActualEndDate = IF(ISBLANK('bridge_employees'[EmploymentEndDate]), ReferenceDate, 'bridge_employees'[EmploymentEndDate])
			    RETURN
			    IF(
			        NOT(ISBLANK(FinalStartDate)),
			        DATEDIFF(FinalStartDate, ActualEndDate, DAY) / 365.25,
			        BLANK()
			    )
			)
		lineageTag: f3cb0e45-8b46-4594-8b44-b21ee81bffcc

	measure 'Actieve Medewerkers in Periode' =
			VAR SelectedStartDate = MIN('dim_date'[Date])
			VAR SelectedEndDate = MAX('dim_date'[Date])
			RETURN
			IF(
			    ISBLANK(SelectedStartDate),
			    BLANK(),
			    COUNTROWS(
			        FILTER(
			            VALUES('bridge_employees'[employeeId]),
			            VAR _start = CALCULATE(MIN('bridge_employees'[EmployeeStartDate]))
			            VAR _contract = CALCULATE(MINX('bridge_employees', COALESCE('bridge_employees'[SeniorityDate], 'bridge_employees'[HRContractStartDate], 'bridge_employees'[CardStart])))
			            VAR EmpStart = COALESCE(_start, _contract)
			            VAR EmpEnd = CALCULATE(MAX('bridge_employees'[EmployeeEndDate]))
			            RETURN
			                NOT(ISBLANK(EmpStart))
			                && EmpStart <= SelectedEndDate
			                && EmpEnd >= SelectedStartDate
			        )
			    )
			)
		formatString: 0
		lineageTag: 3a70d11c-aec5-49d8-87c3-55a644ab629f

