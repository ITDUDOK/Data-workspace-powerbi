	measure TotaleOmzetExBtw_ExclEvents =
			
			VAR IncompatibleFilterActive =
			    ISCROSSFILTERED('dim_product') || ISCROSSFILTERED('dim_productgroup') || ISCROSSFILTERED('dim_table')
			RETURN
			IF(
			    IncompatibleFilterActive,
			    VAR Drempel = 500
			    VAR EventTickets =
			        FILTER(
			            SUMMARIZE(
			                'fact_sales',
			                'fact_sales'[TicketKey],
			                "TicketOmzet", SUM('fact_sales'[LineTotalEx])
			            ),
			            [TicketOmzet] >= Drempel
			        )
			    RETURN
			    CALCULATE(
			        [TotaleOmzetExBtw],
			        EXCEPT(
			            VALUES('fact_sales'[TicketKey]),
			            SELECTCOLUMNS(EventTickets, "TicketKey", 'fact_sales'[TicketKey])
			        )
			    ),
			    SUM('fact_revenue_hourly'[TotaleOmzetExBtw_ExclEvents])
			)
		lineageTag: 93126aaa-5997-4e87-93e2-a4f23d30dab6

	measure Prognose_Horeca = ```
			
			VAR SelectedScenario = SELECTEDVALUE('scenario'[ScenarioID], 1)
			VAR CorrPct = SELECTEDVALUE('correctiefactor'[CorrPercent], 0)
			VAR CorrMultiplier = 1 + CorrPct / 100
			VAR VisibleDates = VALUES('dim_date'[Date])
			VAR NeededDates =
			    DISTINCT(
			        UNION(
			            SELECTCOLUMNS(VisibleDates, "Date", 'dim_date'[Date] - 7),
			            SELECTCOLUMNS(VisibleDates, "Date", 'dim_date'[Date] - 14),
			            SELECTCOLUMNS(VisibleDates, "Date", 'dim_date'[Date] - 21),
			            SELECTCOLUMNS(VisibleDates, "Date", 'dim_date'[Date] - 28),
			            SELECTCOLUMNS(VisibleDates, "Date", 'dim_date'[Date] - 364)
			        )
			    )
			VAR DailyRevenue =
			    ADDCOLUMNS(
			        NeededDates,
			        "Rev",
			            VAR d = [Date]
			            RETURN CALCULATE([TotaleOmzetExBtw_ExclEvents], ALL('dim_date'), 'dim_date'[Date] = d)
			    )
			VAR BaseValue =
			    SWITCH(
			        SelectedScenario,
			        1,
			            SUMX(
			                VisibleDates,
			                VAR d = 'dim_date'[Date]
			                VAR W1 = MAXX(FILTER(DailyRevenue, [Date] = d - 7), [Rev])
			                VAR W2 = MAXX(FILTER(DailyRevenue, [Date] = d - 14), [Rev])
			                VAR W3 = MAXX(FILTER(DailyRevenue, [Date] = d - 21), [Rev])
			                VAR W4 = MAXX(FILTER(DailyRevenue, [Date] = d - 28), [Rev])
			                RETURN MAX(DIVIDE(W1 + W2 + W3 + W4, 4), 0)
			            ),
			        2,
			            SUMX(
			                VisibleDates,
			                VAR d = 'dim_date'[Date]
			                RETURN MAX(MAXX(FILTER(DailyRevenue, [Date] = d - 364), [Rev]), 0)
			            )
			    )
			RETURN
			    ROUND(BaseValue * CorrMultiplier, 0)
			
			```
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 765a1dad-1bfd-4825-a5d3-13cf025c5d20

