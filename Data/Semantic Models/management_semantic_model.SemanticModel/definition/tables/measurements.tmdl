	measure 'Bedrag P&L' =
			VAR Cutoff       = EOMONTH(TODAY(), 0)
			VAR IsGrandTotal = NOT ISINSCOPE('dim_finreportrows'[Hoofdgroep])
			VAR PeriodStart  = MIN('dim_date'[Date])
			VAR IsFuture     = ISFILTERED('dim_date'[MonthName]) && PeriodStart > Cutoff
			
			VAR GrandTotal =
			    CALCULATE(
			        -1 * SUMX(
			            FILTER(
			                'gltransacties_fin',
			                NOT ISBLANK(RELATED('dim_finreportrows'[ClassificatieCode]))
			            ),
			            'gltransacties_fin'[AmountFC]
			        ),
			        KEEPFILTERS('dim_date'[Date] <= Cutoff)
			    )
			
			VAR RowTotal =
			    CALCULATE(
			        SUMX(
			            'gltransacties_fin',
			            'gltransacties_fin'[AmountFC] * RELATED('dim_finreportrows'[Teken])
			        ),
			        KEEPFILTERS('dim_date'[Date] <= Cutoff)
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			        IsFuture,     BLANK(),
			        IsGrandTotal, GrandTotal,
			                      RowTotal
			    )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 3b66438a-6143-4fb5-be52-f7a2a5fb60ef

	measure _Fin_Omzet =
			CALCULATE(
			    SUMX('gltransacties_fin', 'gltransacties_fin'[AmountFC] * RELATED('dim_finreportrows'[Teken])),
			    'dim_finreportrows'[Hoofdgroep] = "Omzet"
			)
		lineageTag: f75e5b0f-f6d6-452c-89c6-62f55065cdea

	measure _Fin_Inkoopwaarde =
			CALCULATE(
			    SUMX('gltransacties_fin', 'gltransacties_fin'[AmountFC] * RELATED('dim_finreportrows'[Teken])),
			    'dim_finreportrows'[Hoofdgroep] = "Inkoopwaarde"
			)
		lineageTag: a2eed78b-234d-4a1c-86ab-9d62dc92b4f9

	measure _Fin_Personeelskosten =
			CALCULATE(
			    SUMX('gltransacties_fin', 'gltransacties_fin'[AmountFC] * RELATED('dim_finreportrows'[Teken])),
			    'dim_finreportrows'[Hoofdgroep] = "Personeelskosten"
			)
		lineageTag: 542f4f73-4e33-4be5-a47e-af50c3f900da

	measure Fin_Kengetal =
			VAR Sel = SELECTEDVALUE('dim_kengetallen'[Kengetal])
			VAR SelPeriod = SELECTEDVALUE('gltransacties_fin'[ReportingPeriod])
			VAR SelYear = MAX('dim_date'[YearISO])
			VAR ActiveDivisions = VALUES('map_division_office'[Division])
			VAR IsToekomst =
			    ISBLANK(SelPeriod)
			    || (SelYear = YEAR(TODAY()) && SelPeriod > MONTH(TODAY()))
			    || SelYear > YEAR(TODAY())
			VAR MinStatus =
			    IF(
			        NOT IsToekomst,
			        IF(
			            NOT ISBLANK(SelPeriod),
			            CALCULATE(
			                MIN('dim_divisionperiodstatus'[YearPeriodStatus]),
			                'dim_divisionperiodstatus'[FinPeriod] = SelPeriod,
			                'dim_divisionperiodstatus'[FinYear] = SelYear,
			                TREATAS(ActiveDivisions, 'dim_divisionperiodstatus'[Division])
			            ),
			            CALCULATE(
			                MIN('dim_divisionperiodstatus'[YearPeriodStatus]),
			                'dim_divisionperiodstatus'[FinYear] = SelYear,
			                TREATAS(ActiveDivisions, 'dim_divisionperiodstatus'[Division])
			            )
			        )
			    )
			VAR PeriodStatus = IF(MinStatus = 1, "Definitief", "Concept")
			RETURN
			IF(
			    IsToekomst && Sel = "Status",
			    BLANK(),
			    SWITCH(
			        Sel,
			        "Personeelskosten %", REPT(UNICHAR(160), 10) & FORMAT(DIVIDE([_Fin_Personeelskosten], [_Fin_Omzet]), "0%"),
			        "Bruto marge %",      REPT(UNICHAR(160), 10) & FORMAT(DIVIDE([_Fin_Omzet] - [_Fin_Inkoopwaarde], [_Fin_Omzet]), "0%"),
			        "Resultaat %",        REPT(UNICHAR(160), 10) & FORMAT(DIVIDE([Bedrag P&L], [_Fin_Omzet]), "0%"),
			        "Status",             PeriodStatus
			    )
			)
		lineageTag: 5f132e38-76e3-4090-97da-b16f28fc9d7c

