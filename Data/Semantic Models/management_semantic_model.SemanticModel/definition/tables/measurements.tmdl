	measure TotaleOmzetExBtw_ByPaymentGroup =
			VAR _GroupPayments = SUM('fact_payments'[PaymodeTotal])
			VAR _TotalPayments =
			    CALCULATE(
			        SUM('fact_payments'[PaymodeTotal]),
			        ALL('fact_payments'[PaymodeGroupName]),
			        ALL('dim_paymentmethod')
			    )
			VAR _Revenue =
			    CALCULATE(
			        [TotaleOmzetExBtw],
			        ALL('fact_payments'[PaymodeGroupName]),
			        ALL('dim_paymentmethod')
			    )
			RETURN
			    DIVIDE(_GroupPayments, _TotalPayments) * _Revenue
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		lineageTag: 9a52dd3e-17bd-4891-8972-777527c57b36

