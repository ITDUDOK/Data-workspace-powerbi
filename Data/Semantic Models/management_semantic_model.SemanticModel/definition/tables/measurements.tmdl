table measurements
	lineageTag: 7f13e6aa-b0a6-436f-9c75-b123f366f970
	sourceLineageTag: [dbo].[measurements]

	measure TotaleOmzetincBTW =
			CALCULATE(
			    SUM('fact_sales'[LineTotalInc]),
			    TREATAS(VALUES('fact_payments'[TicketKey]), 'fact_sales'[TicketKey])
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		lineageTag: 7785011f-f984-48f5-bf57-2dc8517b2063

	measure TotaleOmzetExBtw =
			
			VAR IncompatibleFilterActive =
			    ISCROSSFILTERED('dim_product') || ISCROSSFILTERED('dim_productgroup') || ISCROSSFILTERED('dim_table')
			RETURN
			IF(
			    IncompatibleFilterActive,
			    CALCULATE(
			        SUM('fact_sales'[LineTotalEx]),
			        KEEPFILTERS(
			            TREATAS(VALUES('fact_payments'[TicketKey]), 'fact_sales'[TicketKey])
			        )
			    ),
			    SUM('fact_revenue_hourly'[TotaleOmzetExBtw])
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: b149cdfc-b8df-4535-91c0-307465bcefb8

	measure TotaleOmzetExBTW_PreviousWeek =
			IF(
			    HASONEVALUE('dim_date'[ThisWeekISO]),
			    VAR LastWeekTickets =
			        CALCULATETABLE(
			            VALUES('fact_payments'[TicketKey]),
			            DATEADD('dim_date'[Date], -7, DAY)
			        )
			    RETURN
			    CALCULATE(
			        SUM('fact_sales'[LineTotalEx]),
			        TREATAS(LastWeekTickets, 'fact_sales'[TicketKey]),
			        DATEADD('dim_date'[Date], -7, DAY)
			    ),
			    IF(
			        ISFILTERED('dim_date'[MonthName]),
			        VAR LastMonthTickets =
			            CALCULATETABLE(
			                VALUES('fact_payments'[TicketKey]),
			                DATEADD('dim_date'[Date], -1, MONTH)
			            )
			        RETURN
			        CALCULATE(
			            SUM('fact_sales'[LineTotalEx]),
			            TREATAS(LastMonthTickets, 'fact_sales'[TicketKey]),
			            DATEADD('dim_date'[Date], -1, MONTH)
			        )
			    )
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 6074d205-1640-4362-85f5-2d2ac040cce1

	measure TotaleOmzetExBTW_PercentageChange =
			VAR CurrentWeek = [TotaleOmzetExBtw]
			VAR PreviousWeek = [TotaleOmzetExBTW_PreviousWeek]
			RETURN DIVIDE(CurrentWeek - PreviousWeek, PreviousWeek)
		formatString: 0%;-0%;0%
		lineageTag: df111d05-3b8a-40dd-9b70-8f67a0b516c4

	measure Netto_GewerktUren = SUM('fact_hours'[HourHours])
		formatString: #,0
		lineageTag: dcc43d4b-6e31-4a7a-a5ac-c61ddccee04a

	measure LabourCost =
			SUMX(
			    FILTER('fact_hours', 'fact_hours'[HourHours] > 0),
			    'fact_hours'[HourHours] * 'fact_hours'[SalaryRate]
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: e8d28791-bcdf-48ca-9224-52f6d0630501

		changedProperty = FormatString

	measure LabourCost_PercentageOfRevenue =
			VAR Omzet = [TotaleOmzetExBtw]
			VAR PersoneelsKosten = [LabourCost]
			RETURN DIVIDE(PersoneelsKosten, Omzet, BLANK())
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e6972f7f-0342-49e9-beee-4ee1c6383462

	measure LabourCost_Planning = CALCULATE(SUM('fact_planning'[PlanningCosts]),'fact_planning'[PlanningTypeId] in {"Gepland", "Pool dienst", "Ongeplande dienst"})
