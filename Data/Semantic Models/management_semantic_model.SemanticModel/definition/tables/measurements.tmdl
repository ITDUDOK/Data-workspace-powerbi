	measure Horeca_VorigJaar = ```
			
			VAR VisibleDates = VALUES('dim_date'[Date])
			VAR NeededDates = DISTINCT(SELECTCOLUMNS(VisibleDates, "Date", 'dim_date'[Date] - 364))
			VAR DailyRevenue =
			    ADDCOLUMNS(
			        NeededDates,
			        "Rev",
			            VAR d = [Date]
			            RETURN CALCULATE([TotaleOmzetExBtw_ExclEvents], ALL('dim_date'), 'dim_date'[Date] = d)
			    )
			RETURN
			SUMX(
			    VisibleDates,
			    VAR d = 'dim_date'[Date]
			    RETURN MAX(MAXX(FILTER(DailyRevenue, [Date] = d - 364), [Rev]), 0)
			)
			
			```
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: eb6188a8-8308-4839-ae23-fea403af893b

